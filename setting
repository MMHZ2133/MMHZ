                <div class="card-value" id="days-value-container"></div>
                <!-- نوار RGB برای مهلت -->
                <div class="rgb-progress">
                    <div class="rgb-progress-fill" id="days-progress"></div>
                </div>
                <div class="progress-info">
                    <span><span class="highlight" id="days-percent">0</span><span data-i18n="percent_remaining">٪ باقی‌مانده</span></span>
                    <span data-i18n="expiry_label">تاریخ انقضا:</span>
                </div>
                <div class="progress-info" style="margin-top: 4px;">
                    <span class="highlight" id="expiry-date" style="font-size: 12px;">—</span>
