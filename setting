                expiry = new Date(num > 10000000000 ? num : num * 1000);
            } else expiry = new Date(expiryStr);
            if (!expiry || isNaN(expiry.getTime())) return { valid: false, days: 0, hours: 0, minutes: 0, expired: false };

            const diffMs = expiry.getTime() - Date.now();
            if (diffMs <= 0) return { valid: true, days: 0, hours: 0, minutes: 0, expired: true };

            const totalMinutes = Math.floor(diffMs / 60000);
            return {
                valid: true,
                days: Math.floor(totalMinutes / 1440),
                hours: Math.floor((totalMinutes % 1440) / 60),
                minutes: totalMinutes % 60,
                expired: false
            };
        }

        function formatTimeText(timeData, lang) {
            const t = I18N[lang];
            if (timeData.expired) return t.expired_text;
            const parts = [];
            if (timeData.days > 0) parts.push(`${timeData.days} ${timeData.days === 1 ? t.day : t.days}`);
            if (timeData.hours > 0) parts.push(`${timeData.hours} ${timeData.hours === 1 ? t.hour : t.hours}`);
            if (timeData.days === 0 && timeData.minutes > 0) parts.push(`${timeData.minutes} ${timeData.minutes === 1 ? t.minute : t.minutes}`);
            if (parts.length === 0) return lang === "fa" ? "کمتر از یک دقیقه" : "less than a minute";
            return parts.join(` ${t.and} `) + ` ${t.remaining_prefix}`;
        }

        function calcDaysPercent(timeData) {
            if (timeData.expired) return 0;
            const totalMinutes = 30 * 1440;
            const remainingMinutes = (timeData.days * 1440) + (timeData.hours * 60) + timeData.minutes;
            if (remainingMinutes >= totalMinutes) return 100;
            return Math.max(0, Math.min(100, (remainingMinutes / totalMinutes) * 100));
        }

        function toLocaleDate(dateStr, lang) {
            if (!dateStr || dateStr === "Never Expire" || dateStr === "2099-01-01") return "—";
            try {
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return "—";
                const locale = lang === "fa" ? "fa-IR" : "en-GB";
                return d.toLocaleDateString(locale, { year: 'numeric', month: '2-digit', day: '2-digit' });
            } catch (e) { return "—"; }
        }

        // ==================== Toast ====================
        let toastTimer = null;
        function showToast(msg) {
            const toast = $("app-toast");
            toast.textContent = msg;
            toast.classList.add("show");
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove("show"), 3000);
        }

        // ==================== Modal ====================
        function closeWelcomeModal() {
            const checkbox = $("dont-show-again");
            if (checkbox && checkbox.checked) {
                localStorage.setItem("vp_welcome_dismissed", "true");
            }
            const modal = $("welcome-modal");
            modal.style.opacity = "0";
            setTimeout(() => modal.classList.add("hidden"), 400);
        }

        function showWelcomeModalIfNeeded() {
            const dismissed = localStorage.getItem("vp_welcome_dismissed");
            if (dismissed === "true") {
                $("welcome-modal").classList.add("hidden");
            }
        }

        // ==================== App Click ====================
        function handleAppClick(app) {
            if (app.isCopy) {
                const t = I18N[currentLang];
                const guideKey = app.id === "happ" ? "guide_happ_text" : "guide_npv_text";
                navigator.clipboard.writeText("__SYNC_NORMAL__").then(() => {
                    showToast(t[guideKey]);
                }).catch(() => {
                    showToast(t.copy_error);
                });
                return;
            }
            window.open(app.store, "_blank");
        }

        // ==================== Render Apps ====================
        function renderApps() {
            const containers = {
                android: $("android-apps"),
                ios: $("ios-apps"),
                windows: $("windows-apps")
            };

            Object.keys(containers).forEach(platform => {
                const container = containers[platform];
                if (!container) return;
                container.innerHTML = "";
                APPS[platform].forEach(app => {
                    const btn = document.createElement("a");
                    btn.className = "app-btn";
                    btn.href = "#";
                    btn.innerHTML = `${app.icon}<span>${app.name}</span>`;
                    btn.addEventListener("click", (e) => {
                        e.preventDefault();
                        handleAppClick(app);
                    });
                    container.appendChild(btn);
                });
            });
        }

        // ==================== Language ====================
        function applyLang() {
            const t = I18N[currentLang];
            document.documentElement.lang = currentLang;
            document.documentElement.dir = currentLang === "fa" ? "rtl" : "ltr";

            document.querySelectorAll("[data-i18n]").forEach(el => {
                const key = el.getAttribute("data-i18n");
                if (t[key]) el.textContent = t[key];
            });

            $("lang-flag").textContent = currentLang === "fa" ? "🇮🇷" : "🇬🇧";
            $("lang-text").textContent = currentLang === "fa" ? "FA" : "EN";
            $("footer-text").textContent = t.footer;
            render();
        }

        function toggleLang() {
            currentLang = currentLang === "fa" ? "en" : "fa";
            localStorage.setItem("vp_lang", currentLang);
            applyLang();
        }

        // ==================== Theme ====================
        function applyTheme() {
            document.documentElement.classList.toggle("light", currentTheme === "light");
            $("theme-icon").textContent = currentTheme === "dark" ? "🌙" : "☀️";
        }

        function toggleTheme() {
            currentTheme = currentTheme === "dark" ? "light" : "dark";
            localStorage.setItem("vp_theme", currentTheme);
            applyTheme();
        }

        // ==================== Render ====================
        function render() {
            const t = I18N[currentLang];
            const usageContainer = $("usage-value-container");
            const daysContainer = $("days-value-container");

            // ========== Usage ==========
            if (isUnlimitedGB) {
                const used = parseFloat(DATA.totalGb) || 0;
                usageContainer.innerHTML = `
                    <div class="unlimited-line-1">
                        <span class="infinity-symbol">∞</span>
                        <span>${t.unlimited}</span>
                    </div>
                    <div class="unlimited-line-2">
                        <span class="used-num">${formatNumber(used)} GB</span> ${t.used_text}
                    </div>
                `;
                // نوار متحرک برای نامحدود
                const progressWrap = $("usage-progress-wrap");
                progressWrap.classList.add("unlimited");
                setTimeout(() => {
                    $("usage-progress").style.width = "40%";
                }, 300);
                // مخفی کردن اطلاعات درصد
                $("usage-progress-info").style.display = "none";
            } else {
                const used = parseFloat(DATA.totalGb) || 0;
                const total = parseFloat(DATA.limitTotalGb) || 0;
                const remaining = Math.max(0, total - used);
                const percent = parseFloat(DATA.totalPercent) || 0;

                usageContainer.innerHTML = `
                    <span class="num">${formatNumber(used)}</span>
                    <span class="unit">/</span>
                    <span class="num">${formatNumber(total)}</span>
                    <span class="unit unit-accent">GB</span>
                `;
                $("used-percent").textContent = formatNumber(percent, 1);
                $("remaining-gb").textContent = formatNumber(remaining);
                setTimeout(() => {
                    $("usage-progress").style.width = Math.min(100, percent) + "%";
                }, 300);
            }

            // ========== Days ==========
            if (isUnlimitedDays) {
                daysContainer.innerHTML = `
                    <span class="num" style="font-size: 42px; color: var(--accent-bright); line-height: 0.8;">∞</span>
                    <span class="unit unit-accent" style="font-size: 18px;">${t.unlimited}</span>
                `;
                $("days-progress").style.width = "100%";
                $("time-remaining").textContent = t.no_expiry;
                $("expiry-date").textContent = t.no_expiry;
            } else {
                const timeData = getTimeRemaining(DATA.expiryDate);
                if (!timeData.valid) {
                    daysContainer.innerHTML = `<span class="num">0</span><span class="unit unit-accent">${t.expired}</span>`;
                    $("days-progress").style.width = "0%";
                    $("time-remaining").textContent = t.expired_text;
                    $("expiry-date").textContent = "—";
                } else if (timeData.expired) {
                    daysContainer.innerHTML = `<span class="num">0</span><span class="unit unit-accent">${t.expired}</span>`;
                    $("days-progress").style.width = "0%";
                    $("time-remaining").textContent = t.expired_text;
                    $("expiry-date").textContent = toLocaleDate(DATA.expiryDate, currentLang);
                } else {
                    daysContainer.innerHTML = `<span class="num">${timeData.days}</span><span class="unit unit-accent">${t.days_unit}</span>`;
                    const remainingPercent = calcDaysPercent(timeData);
                    $("time-remaining").textContent = formatTimeText(timeData, currentLang);
                    $("expiry-date").textContent = toLocaleDate(DATA.expiryDate, currentLang);
                    setTimeout(() => { $("days-progress").style.width = remainingPercent + "%"; }, 300);
                }
            }
        }

        // ==================== Init ====================
        (function init() {
            applyTheme();
            applyLang();
            renderApps();
            showWelcomeModalIfNeeded();
        })();
    </script>

</body>
</html>
