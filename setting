<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VaslPlus | __USER_NAME__</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        /* ==================== Variables ==================== */
        :root {
            /* تم شب - مشکی و قرمز */
            --accent: #ff2338;
            --accent-bright: #ff4d5e;
            --accent-glow: rgba(255, 35, 56, 0.4);
            --accent-soft: rgba(255, 35, 56, 0.12);
            --accent-border: rgba(255, 35, 56, 0.35);
            --bg-primary: #000000;
            --card-bg: #1a1a1a;
            --card-bg-inner: #0d0d0d;
            --text-primary: #ffffff;
            --text-muted: #6b6b80;
            --text-secondary: #a0a0b0;
            --border: #2a2a2a;
            --ring-bg: #2a2a2a;
            --gradient-silver: linear-gradient(135deg, #ffffff 0%, #b8b8c8 100%);
            --rgb-gradient: linear-gradient(90deg, #ff0000, #ff8000, #ffff00, #00ff00, #00ffff, #0080ff, #8000ff, #ff00ff, #ff0000);
        }

        html.light {
            /* تم روز - سفید و آبی */
            --accent: #0d6efd;
            --accent-bright: #3b82f6;
            --accent-glow: rgba(13, 110, 253, 0.35);
            --accent-soft: rgba(13, 110, 253, 0.10);
            --accent-border: rgba(13, 110, 253, 0.30);
            --bg-primary: #ffffff;
            --card-bg: #f8fbff;
            --card-bg-inner: #ffffff;
            --text-primary: #0a2540;
            --text-muted: #94a3b8;
            --text-secondary: #475569;
            --border: #e5eefb;
            --ring-bg: #dbeafe;
            --gradient-silver: linear-gradient(135deg, #0a2540 0%, #1e40af 100%);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            font-family: 'Vazirmatn', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            transition: background 0.3s, color 0.3s;
        }

        /* ==================== Top Controls ==================== */
        .top-controls {
            position: fixed;
            top: 20px;
            left: 20px;
            display: flex;
            gap: 8px;
            z-index: 100;
        }
        .ctrl-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 9px 12px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text-secondary);
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: border-color 0.2s, color 0.2s;
        }
        .ctrl-btn:hover {
            border-color: var(--accent);
            color: var(--accent-bright);
        }
        .ctrl-btn svg { width: 18px; height: 18px; }

        .ctrl-btn.support-btn {
            padding: 8px;
        }
        .ctrl-btn.support-btn svg {
            width: 22px;
            height: 22px;
        }

        /* ==================== Container ==================== */
        .container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 640px;
            margin: 0 auto;
            padding: 100px 16px 24px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* ==================== Logo ==================== */
        .logo-header { text-align: center; margin-bottom: 32px; }

        .logo-ring {
            position: relative;
            width: 92px;
            height: 92px;
            margin: 0 auto 16px;
            border-radius: 50%;
            padding: 3px;
            background: conic-gradient(from 0deg,
                #ff0000, #ff8000, #ffff00, #00ff00,
                #00ffff, #0080ff, #8000ff, #ff00ff, #ff0000);
            animation: rgbRotate 4s linear infinite;
        }
        @keyframes rgbRotate {
            from { filter: hue-rotate(0deg); }
            to { filter: hue-rotate(360deg); }
        }
        .logo-mark {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--card-bg);
        }
        .logo-mark svg { width: 44px; height: 44px; }
        .logo-mark .logo-swoosh { stroke: var(--accent-bright); }

        .brand-name {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            direction: ltr;
        }
        .brand-name .vasl {
            background: var(--gradient-silver);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .brand-name .plus {
            color: var(--accent-bright);
        }
        .brand-tagline {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 3px;
            color: var(--text-muted);
            margin-top: 6px;
            direction: ltr;
        }
        .brand-tagline span { color: var(--accent); margin: 0 6px; }

        /* ==================== Greeting ==================== */
        .user-greeting {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 22px;
            font-size: 14px;
            color: var(--text-secondary);
        }
        .user-greeting strong { color: var(--text-primary); font-weight: 700; }

        /* ==================== Cards Grid ==================== */
        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        /* RGB Border Wrapper — فقط دور کارت */
        .card-rgb {
            position: relative;
            border-radius: 18px;
            padding: 3px;
            background: conic-gradient(from 0deg,
                #ff0000, #ff8000, #ffff00, #00ff00,
                #00ffff, #0080ff, #8000ff, #ff00ff, #ff0000);
            animation: rgbRotate 4s linear infinite;
        }
        .card-rgb.full-width {
            grid-column: 1 / -1;
        }

        /* کارت داخلی — رنگ تم */
        .card {
            background: var(--card-bg);
            border-radius: 15px;
            padding: 20px 18px;
            position: relative;
            overflow: hidden;
            height: 100%;
        }

        .card-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent-bright);
            margin-bottom: 14px;
        }
        .card-icon svg { width: 20px; height: 20px; }

        .card-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 10px;
        }

        .card-value {
            font-size: 28px;
            font-weight: 900;
            line-height: 1.1;
            display: flex;
            align-items: baseline;
            gap: 5px;
            direction: ltr;
            flex-wrap: wrap;
        }
        .card-value .num { color: var(--text-primary); }
        .card-value .unit { font-size: 13px; font-weight: 600; color: var(--text-muted); }
        .card-value .unit-accent { color: var(--accent-bright); }
        .card-value .infinity {
            font-size: 42px;
            font-weight: 900;
            color: var(--accent-bright);
            line-height: 0.8;
        }
        .card-value .infinity-text {
            font-size: 18px;
            font-weight: 700;
            color: var(--accent-bright);
            margin-right: 6px;
        }

        /* ==================== RGB Progress ==================== */
        .rgb-progress {
            position: relative;
            height: 8px;
            border-radius: 8px;
            background: var(--ring-bg);
            overflow: hidden;
            margin-top: 14px;
        }
        .rgb-progress-fill {
            height: 100%;
            border-radius: 8px;
            background: var(--rgb-gradient);
            background-size: 300% 100%;
            animation: rgbSlide 3s linear infinite;
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
            width: 0%;
        }
        @keyframes rgbSlide {
            from { background-position: 0% 0; }
            to { background-position: 300% 0; }
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            gap: 6px;
            flex-wrap: wrap;
        }
        .progress-info .highlight {
            color: var(--accent-bright);
            font-weight: 700;
        }

        /* ==================== Time Remaining ==================== */
        .time-remaining {
            margin-top: 12px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--accent-bright);
            text-align: center;
            padding: 9px 10px;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            border-radius: 10px;
        }

        /* ==================== Expiry Box ==================== */
        .expiry-box {
            margin-top: 8px;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-secondary);
            text-align: center;
            padding: 8px 10px;
            background: var(--card-bg-inner);
            border: 1px solid var(--border);
            border-radius: 10px;
        }
        .expiry-box strong {
            color: var(--accent-bright);
            font-weight: 700;
        }

        /* ==================== App Links Grid ==================== */
        .app-links-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-top: 12px;
        }

        .app-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 12px 6px;
            background: var(--card-bg-inner);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 10px;
            font-weight: 700;
            text-align: center;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .app-btn svg {
            width: 22px;
            height: 22px;
            stroke: var(--accent-bright);
            transition: stroke 0.2s;
        }

        .app-btn:hover {
            background: var(--accent);
            border-color: var(--accent-bright);
            color: #ffffff;
            transform: translateY(-2px);
        }

        .app-btn:hover svg {
            stroke: #ffffff;
        }

        /* ==================== Footer ==================== */
        .footer {
            text-align: center;
            margin-top: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .footer .blink-text {
            font-weight: 900;
            font-size: 15px;
            letter-spacing: 1.5px;
        }

        /* روز: قرمز فلاشر */
        html.light .footer .blink-text {
            animation: redBlink 1.2s ease-in-out infinite;
        }
        @keyframes redBlink {
            0%, 100% {
                color: #dc2626;
                text-shadow: 0 0 14px rgba(220, 38, 38, 0.6);
            }
            50% {
                color: #ff6b35;
                text-shadow: 0 0 14px rgba(255, 107, 53, 0.6);
            }
        }

        /* شب: آبی فلاشر */
        html:not(.light) .footer .blink-text {
            animation: blueBlink 1.2s ease-in-out infinite;
        }
        @keyframes blueBlink {
            0%, 100% {
                color: #3b82f6;
                text-shadow: 0 0 14px rgba(59, 130, 246, 0.6);
            }
            50% {
                color: #00d4ff;
                text-shadow: 0 0 14px rgba(0, 212, 255, 0.6);
            }
        }

        /* ==================== Toast ==================== */
        .app-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--card-bg);
            color: var(--text-primary);
            padding: 12px 22px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            z-index: 9999;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.25);
            border: 1px solid var(--border);
            opacity: 0;
            transition: opacity 0.3s, transform 0.3s;
            pointer-events: none;
        }
        .app-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        /* ==================== Animations ==================== */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate { animation: fadeInUp 0.5s ease forwards; opacity: 0; }
        .delay-1 { animation-delay: 0.08s; }
        .delay-2 { animation-delay: 0.16s; }
        .delay-3 { animation-delay: 0.24s; }
        .delay-4 { animation-delay: 0.32s; }
        .delay-5 { animation-delay: 0.4s; }

        /* ==================== Responsive ==================== */
        @media (max-width: 600px) {
            .top-controls { top: 12px; left: 12px; }
            .ctrl-btn { padding: 8px 10px; font-size: 11px; }
            .container { padding: 90px 12px 16px; }
            .cards-grid { grid-template-columns: 1fr; gap: 14px; }
            .card { padding: 18px 16px; }
            .card-value { font-size: 26px; }
            .brand-name { font-size: 22px; }
            .logo-ring { width: 80px; height: 80px; }
            .logo-mark svg { width: 36px; height: 36px; }
            .app-links-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>

