        function openAppDeepLink(appId) {
            const t = I18N[currentLang];
            const allApps = [...APPS.android, ...APPS.ios, ...APPS.windows];
            const app = allApps.find(a => a.id === appId);

            if (!app || !app.deepLink) {
                showToast(t.not_installed_msg);
                return;
            }

            const subLink = "__SYNC_NORMAL__";
            const deepLink = app.deepLink(subLink);
            const startTime = Date.now();

            try {
                window.location.href = deepLink;
            } catch (e) {
                showToast(t.not_installed_msg);
                return;
            }

            setTimeout(() => {
                if (Date.now() - startTime < 2500) {
                    showToast(t.not_installed_msg);
                }
            }, 2000);
        }

