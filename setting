    <!-- ============================================================
         JavaScript - محاسبات دقیق
         ============================================================ -->
    <script>
        // =====================================================
        // 📌 داده‌های داینامیک از بک‌اند
        // =====================================================
        const DATA = {
            usedGB: parseFloat("__USED_GB__") || 0,
            totalGB: parseFloat("__TOTAL_GB__") || 0,
            expiryDate: "__EXPIRY_DATE__" || "",
            isUnlimited: "__IS_UNLIMITED__" === "true" || false
        };

        // =====================================================
        // 🌐 ترجمه‌ها
        // =====================================================
        const I18N = {
            fa: {
                greeting: "خوش آمدی،",
                used_label: "حجم مصرف‌شده",
                days_label: "روزهای باقی‌مانده",
                days_unit: "روز",
                percent_used: "٪ مصرف شده",
                remaining: "باقی‌مانده:",
                expiry_label: "تاریخ انقضا:",
                unlimited: "نامحدود",
                gb_unit: "GB",
                theme_dark: "شب",
                theme_light: "روز",
                expired: "منقضی شده"
            },
            en: {
                greeting: "Welcome,",
                used_label: "Data Used",
                days_label: "Days Remaining",
                days_unit: "days",
                percent_used: "% used",
                remaining: "Remaining:",
                expiry_label: "Expiry date:",
                unlimited: "Unlimited",
                gb_unit: "GB",
                theme_dark: "Dark",
                theme_light: "Light",
                expired: "Expired"
            }
        };

        let currentLang = localStorage.getItem("vp_lang") || "fa";
        let currentTheme = localStorage.getItem("vp_theme") || "dark";

        const $ = (id) => document.getElementById(id);

        // =====================================================
        // 🔢 فرمت اعداد (دقیق، بدون حذف نادرست اعشار)
        // =====================================================
        function formatNumber(num, maxDecimals = 2) {
            if (!isFinite(num)) return "0";
            if (num === 0) return "0";

            // گرد کردن به تعداد اعشار مشخص
            const rounded = Math.round(num * Math.pow(10, maxDecimals)) / Math.pow(10, maxDecimals);

            // اگه عدد صحیح بود، بدون اعشار نمایش بده
            if (rounded === Math.floor(rounded)) {
                return rounded.toString();
            }

            // حذف صفرهای انتهایی
            return parseFloat(rounded.toFixed(maxDecimals)).toString();
        }

        // =====================================================
        // 📅 محاسبه‌ی دقیق روزهای باقی‌مانده
        // =====================================================
        function calcDaysLeft(expiryStr) {
            if (!expiryStr || expiryStr === "__EXPIRY_DATE__" || expiryStr.trim() === "") {
                return { days: 0, expired: true };
            }

            // پارس کردن تاریخ انقضا
            const expiry = new Date(expiryStr);
            if (isNaN(expiry.getTime())) {
                return { days: 0, expired: true };
            }

            // زمان فعلی
            const now = new Date();

            // اختلاف به میلی‌ثانیه
            const diffMs = expiry.getTime() - now.getTime();

            // اگه منقضی شده
            if (diffMs <= 0) {
                return { days: 0, expired: true };
            }

            // محاسبه‌ی دقیق روزها + ساعت باقی‌مانده
            const totalHours = diffMs / (1000 * 60 * 60);
            const fullDays = Math.floor(totalHours / 24);
            const remainingHours = totalHours % 24;

            // اگه بیشتر از 0 ساعت مونده باشه، یک روز اضافه می‌شه
            // این استاندارد استاندارد برای نمایش "روز باقی‌مانده" هست
            const days = remainingHours > 0 ? fullDays + 1 : fullDays;

            return { days: Math.max(0, days), expired: false };
        }

        // =====================================================
        // 📅 فرمت تاریخ
        // =====================================================
        function toLocaleDate(dateStr, lang) {
            if (!dateStr || dateStr === "__EXPIRY_DATE__") return "—";
            try {
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return "—";
                const locale = lang === "fa" ? "fa-IR" : "en-GB";
                return d.toLocaleDateString(locale, {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit'
                });
            } catch (e) {
                return "—";
            }
        }

        // =====================================================
        // 🌐 تغییر زبان
        // =====================================================
        function applyLang() {
            const t = I18N[currentLang];

            document.documentElement.lang = currentLang;
            document.documentElement.dir = currentLang === "fa" ? "rtl" : "ltr";

            document.querySelectorAll("[data-i18n]").forEach(el => {
                const key = el.getAttribute("data-i18n");
                if (t[key]) el.textContent = t[key];
            });

            $("lang-flag").textContent = currentLang === "fa" ? "🇮🇷" : "🇬🇧";
            $("lang-text").textContent = currentLang === "fa" ? "FA" : "EN";

            updateThemeButtonText();
            render();
        }

        function toggleLang() {
            currentLang = currentLang === "fa" ? "en" : "fa";
            localStorage.setItem("vp_lang", currentLang);
            applyLang();
        }

        // =====================================================
        // 🌙/☀️ تغییر تم
        // =====================================================
        function applyTheme() {
            document.body.classList.toggle("light", currentTheme === "light");

            const moon = $("theme-icon-moon");
            const sun = $("theme-icon-sun");

            if (currentTheme === "dark") {
                moon.style.display = "block";
                sun.style.display = "none";
            } else {
                moon.style.display = "none";
                sun.style.display = "block";
            }

            updateThemeButtonText();
        }

        function updateThemeButtonText() {
            const t = I18N[currentLang];
            $("theme-text").textContent = currentTheme === "dark"
                ? t.theme_dark
                : t.theme_light;
        }

        function toggleTheme() {
            currentTheme = currentTheme === "dark" ? "light" : "dark";
            localStorage.setItem("vp_theme", currentTheme);
            applyTheme();
        }

        // =====================================================
        // 📊 رندر داده‌ها (با محاسبات دقیق)
        // =====================================================
        function render() {
            const t = I18N[currentLang];
            const usageContainer = $("usage-value-container");
            const progressWrap = $("usage-progress-wrap");

            // ==========================================
            // حجم مصرفی
            // ==========================================
            if (DATA.isUnlimited) {
                usageContainer.innerHTML = `
                    <span class="infinity">∞</span>
                    <span class="unit unit-accent" style="margin-right:6px;">${t.unlimited}</span>
                `;
                progressWrap.style.display = "none";
            } else {
                // محاسبه‌ی دقیق
                const used = Math.max(0, DATA.usedGB);
                const total = Math.max(0, DATA.totalGB);
                const remaining = Math.max(0, total - used);

                // درصد مصرف (دقیق، بین 0 تا 100)
                const percent = total > 0
                    ? Math.min(100, Math.max(0, (used / total) * 100))
                    : 0;

                // نمایش اعداد
                usageContainer.innerHTML = `
                    <span class="num">${formatNumber(used)}</span>
                    <span class="unit">/</span>
                    <span class="num">${formatNumber(total)}</span>
                    <span class="unit unit-accent">GB</span>
                `;

                progressWrap.style.display = "block";

                // درصد (بدون اعشار اگه صحیح بود)
                const percentDisplay = Math.round(percent * 10) / 10;
                $("used-percent").textContent = formatNumber(percentDisplay, 1);

                // حجم باقی‌مانده (دقیق)
                $("remaining-gb").textContent = formatNumber(remaining);

                // انیمیشن نوار
                setTimeout(() => {
                    $("usage-progress").style.width = percent + "%";
                }, 200);
            }

            // ==========================================
            // روزهای باقی‌مانده
            // ==========================================
            const result = calcDaysLeft(DATA.expiryDate);
            const daysLeft = result.days;

            $("days-value").textContent = daysLeft;

            // اگه منقضی شده، متن رو عوض کن
            const daysUnitEl = document.querySelector('[data-i18n="days_unit"]');
            if (result.expired && DATA.expiryDate && DATA.expiryDate !== "__EXPIRY_DATE__") {
                daysUnitEl.textContent = t.expired;
            } else {
                daysUnitEl.textContent = t.days_unit;
            }

            $("expiry-date").textContent = toLocaleDate(DATA.expiryDate, currentLang);

            // ==========================================
            // نقاط روزها (7 نقطه)
            // ==========================================
            const ring = $("days-ring");
            ring.innerHTML = "";

            const segments = 7;
            const filledSegments = daysLeft >= 30
                ? segments
                : Math.max(0, Math.round((daysLeft / 30) * segments));

            for (let i = 0; i < segments; i++) {
                const seg = document.createElement("div");
                seg.className = "day-seg" + (i < filledSegments ? " active" : "");
                ring.appendChild(seg);
            }
        }

        // =====================================================
        // 🚀 راه‌اندازی
        // =====================================================
        (function init() {
            // داده نمونه در صورت نبود مقادیر
            if (DATA.usedGB === 0 && DATA.totalGB === 0 && !DATA.isUnlimited) {
                DATA.usedGB = 3.2;
                DATA.totalGB = 10;
                const future = new Date();
                future.setDate(future.getDate() + 18);
                DATA.expiryDate = future.toISOString().split("T")[0];
            }

            applyTheme();
            applyLang();
        })();
    </script>

</body>
</html>
