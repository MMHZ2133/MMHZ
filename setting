<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VaslPlus | __USER_NAME__</title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ===== Reset & Base ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            /* ===== Dark Theme (پیش‌فرض) - VaslPlus Red ===== */
            --bg-primary: #0a0a0f;
            --bg-card: #14141c;
            --bg-card-hover: #1c1c28;
            --bg-soft: #1a1a24;

            --accent: #e11d2e;
            --accent-bright: #ff2338;
            --accent-glow: rgba(225, 29, 46, 0.4);
            --accent-soft: rgba(225, 29, 46, 0.12);
            --accent-border: rgba(225, 29, 46, 0.35);

            --white: #ffffff;
            --text-primary: #ffffff;
            --text-secondary: #a0a0b0;
            --text-muted: #5a5a6e;

            --border: #23232f;
            --gradient-accent: linear-gradient(135deg, #e11d2e 0%, #ff2338 100%);
            --gradient-silver: linear-gradient(135deg, #ffffff 0%, #b8b8c8 100%);

            --shadow-card: 0 4px 24px rgba(0, 0, 0, 0.6);
            --shadow-accent: 0 8px 32px rgba(225, 29, 46, 0.25);

            --grid-color: rgba(255, 255, 255, 0.015);
            --ring-bg: #23232f;

            --radius: 16px;
            --radius-sm: 10px;
            --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ===== Light Theme (روز) - Green ===== */
        body.light {
            --bg-primary: #f5f7f5;
            --bg-card: #ffffff;
            --bg-card-hover: #f0fdf4;
            --bg-soft: #f0fdf4;

            --accent: #16a34a;
            --accent-bright: #22c55e;
            --accent-glow: rgba(22, 163, 74, 0.35);
            --accent-soft: rgba(22, 163, 74, 0.12);
            --accent-border: rgba(22, 163, 74, 0.35);

            --white: #14532d;
            --text-primary: #14532d;
            --text-secondary: #4b5563;
            --text-muted: #9ca3af;

            --border: #e5e7eb;
            --gradient-accent: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
            --gradient-silver: linear-gradient(135deg, #14532d 0%, #166534 100%);

            --shadow-card: 0 4px 24px rgba(22, 163, 74, 0.08);
            --shadow-accent: 0 8px 32px rgba(22, 163, 74, 0.2);

            --grid-color: rgba(22, 163, 74, 0.04);
            --ring-bg: #e5e7eb;
        }

        body.light .logo-mark {
            background: #ffffff;
            border-color: var(--accent);
            box-shadow: 0 0 30px var(--accent-glow), inset 0 0 20px rgba(22, 163, 74, 0.1);
        }

        body.light .brand-name .vasl {
            background: linear-gradient(135deg, #14532d 0%, #16a34a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        body.light .brand-name .plus {
            color: #22c55e;
            text-shadow: 0 0 16px rgba(22, 163, 74, 0.3);
        }

        body.light .brand-tagline span {
            color: #16a34a;
        }

        body.light .logo-swoosh { stroke: #22c55e !important; }
        body.light .logo-globe { stroke: #22c55e !important; }
        body.light #silverGrad stop:first-child { stop-color: #14532d; }
        body.light #silverGrad stop:last-child { stop-color: #16a34a; }

        body.light .card {
            box-shadow: 0 4px 20px rgba(22, 163, 74, 0.06);
        }

        body.light .card::after {
            background: radial-gradient(circle, rgba(22, 163, 74, 0.08) 0%, transparent 70%);
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            padding: 24px 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.4s ease, color 0.4s ease;
            background-image:
                radial-gradient(circle at 20% 20%, var(--accent-soft) 0%, transparent 45%),
                radial-gradient(circle at 80% 80%, var(--accent-soft) 0%, transparent 45%),
                linear-gradient(var(--grid-color) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
            background-size: auto, auto, 40px 40px, 40px 40px;
        }

        .top-controls {
            position: fixed;
            top: 20px;
            left: 20px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }

        .ctrl-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 14px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all var(--transition);
            box-shadow: var(--shadow-card);
        }

        .ctrl-btn:hover {
            border-color: var(--accent);
            color: var(--accent-bright);
            transform: translateY(-2px);
            box-shadow: var(--shadow-accent);
        }

        .ctrl-btn svg {
            width: 16px;
            height: 16px;
        }

        .ctrl-btn .flag {
            font-size: 14px;
        }

        .container {
            width: 100%;
            max-width: 640px;
            position: relative;
            z-index: 1;
        }

        .logo-header {
            text-align: center;
            margin-bottom: 36px;
        }

        .logo-mark {
            width: 72px;
            height: 72px;
            margin: 0 auto 14px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-card);
            border: 2px solid var(--accent);
            box-shadow: 0 0 30px var(--accent-glow), inset 0 0 20px var(--accent-soft);
            position: relative;
            transition: all 0.4s ease;
        }

        .logo-mark svg {
            width: 38px;
            height: 38px;
        }

        .brand-name {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            direction: ltr;
        }

        .brand-name .vasl {
            background: var(--gradient-silver);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: all 0.4s ease;
        }

        .brand-name .plus {
            color: var(--accent-bright);
            text-shadow: 0 0 20px var(--accent-glow);
            transition: all 0.4s ease;
        }

        .brand-tagline {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 3px;
            color: var(--text-muted);
            margin-top: 6px;
            direction: ltr;
        }

        .brand-tagline span {
            color: var(--accent);
            margin: 0 6px;
            transition: color 0.4s ease;
        }

        .user-greeting {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 24px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        .user-greeting strong {
            color: var(--text-primary);
            font-weight: 700;
        }

        .user-greeting svg {
            color: var(--accent-bright);
            transition: color 0.4s ease;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px 22px;
            position: relative;
            overflow: hidden;
            transition: all var(--transition);
            box-shadow: var(--shadow-card);
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--gradient-accent);
            opacity: 0.7;
            transition: opacity 0.3s;
        }

        .card::after {
            content: '';
            position: absolute;
            top: -60px;
            left: -60px;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
            pointer-events: none;
            transition: background 0.4s ease;
        }

        .card:hover {
            border-color: var(--accent-border);
            transform: translateY(-4px);
            box-shadow: var(--shadow-accent);
        }

        .card:hover::before {
            opacity: 1;
        }

        .card-icon {
            width: 42px;
            height: 42px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent-bright);
            margin-bottom: 16px;
            position: relative;
            z-index: 1;
            transition: all 0.4s ease;
        }

        .card-icon svg {
            width: 20px;
            height: 20px;
        }

        .card-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 10px;
            position: relative;
            z-index: 1;
            letter-spacing: 0.3px;
        }

        .card-value {
            font-size: 30px;
            font-weight: 900;
            line-height: 1;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: baseline;
            gap: 5px;
            direction: ltr;
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .card-value .num {
            color: var(--text-primary);
            transition: color 0.4s ease;
        }

        .card-value .unit {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .card-value .unit-accent {
            color: var(--accent-bright);
            transition: color 0.4s ease;
        }

        .card-value .infinity {
            font-size: 42px;
            font-weight: 900;
            color: var(--accent-bright);
            text-shadow: 0 0 20px var(--accent-glow);
            line-height: 0.8;
            transition: all 0.4s ease;
        }

        .progress-wrap {
            margin-top: 16px;
            position: relative;
            z-index: 1;
        }

        .progress-track {
            height: 8px;
            border-radius: 8px;
            background: var(--ring-bg);
            overflow: hidden;
            position: relative;
            transition: background 0.4s ease;
        }

        .progress-fill {
            height: 100%;
            border-radius: 8px;
            background: var(--gradient-accent);
            box-shadow: 0 0 12px var(--accent-glow);
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1), background 0.4s ease;
            position: relative;
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
            animation: shimmer 2.2s infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            gap: 8px;
            flex-wrap: wrap;
        }

        .progress-info .highlight {
            color: var(--accent-bright);
            font-weight: 700;
            transition: color 0.4s ease;
        }

        .days-ring {
            margin-top: 16px;
            display: flex;
            gap: 4px;
            position: relative;
            z-index: 1;
        }

        .day-seg {
            flex: 1;
            height: 6px;
            border-radius: 4px;
            background: var(--ring-bg);
            transition: all 0.4s;
        }

        .day-seg.active {
            background: var(--gradient-accent);
            box-shadow: 0 0 8px var(--accent-glow);
        }

        .footer {
            text-align: center;
            margin-top: 28px;
            font-size: 11px;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            direction: ltr;
            font-weight: 600;
        }

        .footer .dot {
            color: var(--accent);
            margin: 0 6px;
            transition: color 0.4s ease;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            opacity: 0;
        }

        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        @media (max-width: 600px) {
            body { padding: 60px 12px 16px; }
            .top-controls { top: 12px; left: 12px; }
            .ctrl-btn { padding: 7px 10px; font-size: 11px; }
            .cards-grid { grid-template-columns: 1fr; gap: 14px; }
            .card { padding: 22px 20px; }
            .card-value { font-size: 28px; }
            .brand-name { font-size: 22px; }
            .logo-mark { width: 64px; height: 64px; }
            .logo-mark svg { width: 32px; height: 32px; }
            .logo-header { margin-bottom: 28px; }
        }
    </style>
</head>
<body>

