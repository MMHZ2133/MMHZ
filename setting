<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>__USER_NAME__ - پنل اشتراک</title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ===== Reset & Base ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            /* Light theme */
            --bg-page: #f0f2f8;
            --bg-card: #ffffff;
            --bg-soft: #f7f8fc;
            --text-primary: #1e1b4b;
            --text-secondary: #6b7280;
            --text-muted: #9ca3af;

            --indigo: #6366f1;
            --indigo-light: #818cf8;
            --purple: #a855f7;
            --purple-light: #c084fc;
            --gradient-main: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            --gradient-soft: linear-gradient(135deg, #eef2ff 0%, #faf5ff 100%);

            --border: #e5e7eb;
            --shadow-sm: 0 1px 3px rgba(30, 27, 75, 0.06);
            --shadow-md: 0 4px 16px rgba(30, 27, 75, 0.08);
            --shadow-lg: 0 12px 32px rgba(99, 102, 241, 0.15);

            --radius: 20px;
            --radius-sm: 12px;
            --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            min-height: 100vh;
            padding: 24px 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image:
                radial-gradient(circle at 15% 20%, rgba(99, 102, 241, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(168, 85, 247, 0.08) 0%, transparent 40%);
        }

        /* ===== Container ===== */
        .container {
            width: 100%;
            max-width: 720px;
            position: relative;
            z-index: 1;
        }

        /* ===== Header ===== */
        .header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 32px;
            padding: 0 4px;
        }

        .avatar {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--gradient-main);
            color: #ffffff;
            flex-shrink: 0;
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
        }

        .avatar svg {
            width: 26px;
            height: 26px;
        }

        .header-text h1 {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.3;
        }

        .header-text p {
            font-size: 13px;
            color: var(--text-secondary);
            font-weight: 500;
            margin-top: 2px;
        }

        /* ===== Cards Grid ===== */
        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        /* ===== Card ===== */
        .card {
            background: var(--bg-card);
            border-radius: var(--radius);
            padding: 28px 24px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border);
            transition: all var(--transition);
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--gradient-soft);
            opacity: 0.7;
            transform: translate(40%, -40%);
            pointer-events: none;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(99, 102, 241, 0.3);
        }

        /* ===== Card Icon ===== */
        .card-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
            position: relative;
            z-index: 1;
        }

        .card-icon-usage {
            background: rgba(99, 102, 241, 0.12);
            color: var(--indigo);
        }

        .card-icon-days {
            background: rgba(168, 85, 247, 0.12);
            color: var(--purple);
        }

        .card-icon svg {
            width: 22px;
            height: 22px;
        }

        /* ===== Card Label ===== */
        .card-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 8px;
            position: relative;
            z-index: 1;
        }

        /* ===== Card Value ===== */
        .card-value {
            font-size: 36px;
            font-weight: 900;
            line-height: 1.1;
            color: var(--text-primary);
            position: relative;
            z-index: 1;
            display: flex;
            align-items: baseline;
            gap: 6px;
        }

        .card-value .unit {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .card-value.gradient-usage {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card-value.gradient-days {
            background: linear-gradient(135deg, #a855f7, #d946ef);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ===== Progress Bar ===== */
        .progress-wrap {
            margin-top: 18px;
            position: relative;
            z-index: 1;
        }

        .progress-track {
            height: 8px;
            border-radius: 8px;
            background: #eef2ff;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            height: 100%;
            border-radius: 8px;
            background: var(--gradient-main);
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
            font-size: 12px;
            font-weight: 500;
            color: var(--text-muted);
        }

        .progress-percent {
            font-weight: 700;
            color: var(--indigo);
        }

        /* ===== Days Bar (visual decoration) ===== */
        .days-deco {
            margin-top: 18px;
            display: flex;
            gap: 4px;
            position: relative;
            z-index: 1;
        }

        .day-dot {
            flex: 1;
            height: 6px;
            border-radius: 6px;
            background: #f3e8ff;
            transition: background 0.4s;
        }

        .day-dot.active {
            background: linear-gradient(135deg, #a855f7, #d946ef);
        }

        /* ===== Footer ===== */
        .footer {
            text-align: center;
            margin-top: 32px;
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .footer .brand {
            color: var(--indigo);
            font-weight: 700;
        }

        /* ===== Animations ===== */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            opacity: 0;
        }

        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }

        /* ===== Responsive ===== */
        @media (max-width: 640px) {
            body { padding: 16px 12px; }
            .cards-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .card { padding: 24px 20px; }
            .card-value { font-size: 32px; }
            .header { margin-bottom: 24px; }
            .header-text h1 { font-size: 18px; }
            .avatar { width: 50px; height: 50px; }
            .avatar svg { width: 22px; height: 22px; }
        }

        /* ===== Dark Mode (اختیاری) ===== */
        body.dark {
            --bg-page: #0f0f1a;
            --bg-card: #1a1a2e;
            --bg-soft: #16162a;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --border: #2a2a3e;
            --gradient-soft: linear-gradient(135deg, #1e1b4b 0%, #2e1065 100%);
        }

        body.dark .progress-track {
            background: #2a2a3e;
        }

        body.dark .day-dot {
            background: #2a2a3e;
        }

        body.dark .card::before {
            opacity: 0.3;
        }
    </style>
</head>
<body>

    <div class="container">

        <!-- ===== Header ===== -->
        <div class="header animate delay-1">
            <div class="avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div class="header-text">
                <h1>__USER_NAME__</h1>
                <p>وضعیت اشتراک شما</p>
            </div>
        </div>

        <!-- ===== Cards Grid ===== -->
        <div class="cards-grid">

            <!-- ===== کارت میزان مصرف ===== -->
            <div class="card animate delay-2">
                <div class="card-icon card-icon-usage">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7z"/>
                        <path d="M8 12h8"/>
                    </svg>
                </div>

                <div class="card-label">میزان مصرف</div>
                <div class="card-value gradient-usage">
                    __TOTAL_GB__ <span class="unit">GB</span>
                </div>

                <div class="progress-wrap">
                    <div class="progress-track">
                        <div class="progress-fill" style="width: __USAGE_PERCENT__%;"></div>
                    </div>
                    <div class="progress-info">
                        <span>__USAGE_PERCENT__٪ مصرف شده</span>
                        <span>از __LIMIT_TOTAL_GB__ GB</span>
                    </div>
                </div>
            </div>

            <!-- ===== کارت روزهای باقی‌مانده ===== -->
            <div class="card animate delay-3">
                <div class="card-icon card-icon-days">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </div>

                <div class="card-label">روزهای باقی‌مانده</div>
                <div class="card-value gradient-days">
                    __DAYS_LEFT__ <span class="unit">روز</span>
                </div>

                <div class="days-deco">
                    <div class="day-dot active"></div>
                    <div class="day-dot active"></div>
                    <div class="day-dot active"></div>
                    <div class="day-dot"></div>
                    <div class="day-dot"></div>
                    <div class="day-dot"></div>
                    <div class="day-dot"></div>
                </div>
            </div>

        </div>

        <!-- ===== Footer ===== -->
        <div class="footer animate delay-3">
            <span class="brand">✦ Panel ✦</span>
        </div>

    </div>

</body>
</html>
