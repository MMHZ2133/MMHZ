<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VaslPlus | __USER_NAME__</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ==================== متغیرهای تم شیشه‌ای آبی ==================== */
        :root {
            /* 🌙 حالت شب - شیشه‌ای آبی */
            --accent: #38bdf8;
            --accent-bright: #7dd3fc;
            --accent-glow: rgba(56, 189, 248, 0.35);
            --accent-soft: rgba(56, 189, 248, 0.12);
            --accent-border: rgba(56, 189, 248, 0.25);

            --bg-primary: #0a0a0f;
            --card-bg: rgba(12, 74, 110, 0.35);
            --card-bg-inner: rgba(8, 47, 73, 0.5);
            --card-border: rgba(255, 255, 255, 0.12);
            --glass-highlight: rgba(255, 255, 255, 0.1);

            --text-primary: #e0f2fe;
            --text-secondary: #7dd3fc;
            --text-muted: #64748b;

            --border: rgba(255, 255, 255, 0.12);
            --ring-bg: rgba(255, 255, 255, 0.1);

            --gradient-silver: linear-gradient(135deg, #e0f2fe 0%, #7dd3fc 100%);

            --blue: #0ea5e9;
            --blue-glow: rgba(14, 165, 233, 0.4);
            --green: #22c55e;
            --green-glow: rgba(34, 197, 94, 0.4);

            --glass-blur: blur(20px) saturate(180%);
        }

        html.light {
            /* ☀️ حالت روز - شیشه‌ای آبی */
            --accent: #0284c7;
            --accent-bright: #0ea5e9;
            --accent-glow: rgba(2, 132, 199, 0.3);
            --accent-soft: rgba(2, 132, 199, 0.08);
            --accent-border: rgba(2, 132, 199, 0.2);

            --bg-primary: #e0f2fe;
            --card-bg: rgba(255, 255, 255, 0.45);
            --card-bg-inner: rgba(240, 249, 255, 0.6);
            --card-border: rgba(255, 255, 255, 0.6);
            --glass-highlight: rgba(255, 255, 255, 0.4);

            --text-primary: #082f49;
            --text-secondary: #0369a1;
            --text-muted: #64748b;

            --border: rgba(186, 230, 253, 0.8);
            --ring-bg: rgba(186, 230, 253, 0.6);

            --gradient-silver: linear-gradient(135deg, #082f49 0%, #0c4a6e 100%);

            --blue: #0ea5e9;
            --green: #16a34a;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            font-family: 'Vazirmatn', sans-serif;
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            transition: color 0.4s;
        }

        /* ==================== پس‌زمینه شیشه‌ای متحرک ==================== */
        body::before {
            content: '';
            position: fixed;
            inset: -50%;
            background: conic-gradient(from 0deg,
                #38bdf8, #0ea5e9, #0284c7, #7dd3fc,
                #38bdf8, #0ea5e9, #0284c7, #7dd3fc);
            animation: rotateBg 20s linear infinite;
            z-index: -2;
        }
        @keyframes rotateBg {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: var(--bg-primary);
            opacity: 0.75;
            backdrop-filter: blur(80px);
            -webkit-backdrop-filter: blur(80px);
            z-index: -1;
            transition: background 0.4s, opacity 0.4s;
        }

        /* ==================== مودال ==================== */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 1;
            transition: opacity 0.4s;
        }
        .modal-overlay.hidden { display: none; }

        .modal-card {
            background: var(--card-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 28px 24px;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3),
                        inset 0 1px 0 var(--glass-highlight);
            animation: modalIn 0.4s ease;
            max-height: 90vh;
            overflow-y: auto;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.95) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .modal-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent-bright);
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .modal-icon svg { width: 30px; height: 30px; }

        .modal-title {
            font-size: 17px;
            font-weight: 800;
            color: var(--accent-bright);
            text-align: center;
            margin-bottom: 14px;
        }

        .modal-text {
            font-size: 13px;
            line-height: 1.9;
            color: var(--text-secondary);
            text-align: center;
            margin-bottom: 18px;
        }
        .modal-text p { margin-bottom: 8px; }
        .modal-text .thanks {
            color: var(--accent-bright);
            font-weight: 700;
            font-size: 13px;
            margin-top: 12px;
        }

        .modal-checkbox {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 18px;
            font-size: 12px;
            color: var(--text-muted);
            cursor: pointer;
        }
        .modal-checkbox input {
            width: 16px;
            height: 16px;
            accent-color: var(--accent);
            cursor: pointer;
        }

        .modal-btn {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 8px 24px var(--accent-glow);
        }
        .modal-btn:hover {
            opacity: 0.95;
            transform: translateY(-2px);
        }

        /* مودال اپ */
        .app-modal-icon {
            width: 72px;
            height: 72px;
            margin: 0 auto 14px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent-bright);
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .app-modal-icon svg { width: 38px; height: 38px; }

        .app-modal-title {
            font-size: 20px;
            font-weight: 900;
            color: var(--text-primary);
            text-align: center;
            margin-bottom: 16px;
        }

        .app-modal-desc {
            font-size: 12.5px;
            line-height: 1.9;
            color: var(--text-secondary);
            margin-bottom: 14px;
            padding: 14px;
            background: var(--card-bg-inner);
            backdrop-filter: blur(10px);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            text-align: right;
            box-shadow: inset 0 1px 0 var(--glass-highlight);
        }
        .app-modal-desc .desc-title {
            color: var(--accent-bright);
            font-weight: 800;
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
        }
        .app-modal-desc .desc-text {
            font-size: 12px;
            line-height: 1.9;
            margin-bottom: 12px;
        }
        .app-modal-desc .steps-title {
            color: var(--accent-bright);
            font-weight: 800;
            display: block;
            margin-top: 10px;
            margin-bottom: 6px;
            font-size: 13px;
        }
        .app-modal-desc .note-box {
            margin-top: 10px;
            padding: 8px 10px;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            border-radius: 8px;
            font-size: 11.5px;
            color: var(--accent-bright);
            font-weight: 600;
        }
        .app-modal-desc .download-box {
            margin-top: 10px;
            padding: 10px 12px;
            background: rgba(14, 165, 233, 0.12);
            border: 1px solid rgba(14, 165, 233, 0.3);
            border-radius: 8px;
            font-size: 12px;
            color: var(--accent-bright);
            font-weight: 600;
            line-height: 1.7;
        }

        .app-modal-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .app-modal-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 13px;
            border: none;
            border-radius: 12px;
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            width: 100%;
        }
        .app-modal-btn:hover { transform: translateY(-2px); }
        .app-modal-btn svg { width: 20px; height: 20px; }

        .btn-install {
            background: linear-gradient(135deg, var(--blue), var(--accent-bright));
            color: #ffffff;
            box-shadow: 0 4px 16px var(--blue-glow);
        }
        .btn-open {
            background: linear-gradient(135deg, var(--green), #16a34a);
            color: #ffffff;
            box-shadow: 0 4px 16px var(--green-glow);
        }
        .btn-copy {
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            color: #ffffff;
            box-shadow: 0 4px 16px var(--accent-glow);
        }
        .btn-cancel {
            background: transparent;
            color: var(--text-muted);
            border: 1px solid var(--border);
        }
        .btn-cancel:hover {
            border-color: var(--accent);
            color: var(--accent-bright);
        }

        /* ==================== کنترل‌های بالا ==================== */
        .top-controls {
            position: fixed;
            top: 20px;
            left: 20px;
            display: flex;
            gap: 8px;
            z-index: 100;
        }
        .ctrl-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 14px;
            background: var(--card-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            color: var(--text-secondary);
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1),
                        inset 0 1px 0 var(--glass-highlight);
        }
        .ctrl-btn:hover {
            border-color: var(--accent);
            color: var(--accent-bright);
            transform: translateY(-3px);
            box-shadow: 0 8px 24px var(--accent-glow);
        }
        .ctrl-btn svg { width: 18px; height: 18px; }

        .ctrl-btn.lang-btn { padding: 10px 12px; }
        .ctrl-btn.lang-btn .flag-emoji { font-size: 16px; }

        .ctrl-btn.theme-btn { padding: 10px 12px; }
        .ctrl-btn.theme-btn:hover svg {
            animation: rotateIcon 0.6s ease;
        }
        @keyframes rotateIcon {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .ctrl-btn.support-btn {
            padding: 10px;
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            border-color: var(--accent);
            color: #ffffff;
            box-shadow: 0 4px 16px var(--accent-glow);
        }
        .ctrl-btn.support-btn:hover {
            background: linear-gradient(135deg, var(--accent-bright), var(--accent));
            border-color: var(--accent-bright);
            color: #ffffff;
            box-shadow: 0 8px 32px var(--accent-glow);
        }
        .ctrl-btn.support-btn svg {
            width: 22px;
            height: 22px;
            stroke: #ffffff;
        }

        /* ==================== کانتینر ==================== */
        .container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 640px;
            margin: 0 auto;
            padding: 100px 16px 24px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* ==================== لوگو ==================== */
        .logo-header { text-align: center; margin-bottom: 28px; }

        .logo-ring {
            position: relative;
            width: 88px;
            height: 88px;
            margin: 0 auto 14px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            box-shadow: 0 0 30px var(--accent-glow), inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }
        .logo-mark {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--card-bg);
            backdrop-filter: blur(20px);
        }
        .logo-mark svg { width: 42px; height: 42px; }

        .brand-name {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            direction: ltr;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }
        .brand-name .vasl {
            background: var(--gradient-silver);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .brand-name .plus { color: var(--accent-bright); }
        .brand-tagline {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 3px;
            color: var(--text-muted);
            margin-top: 6px;
            direction: ltr;
        }
        .brand-tagline span { color: var(--accent); margin: 0 6px; }

        /* ==================== خوش‌آمدگویی ==================== */
        .user-greeting {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            color: var(--text-secondary);
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }
        .user-greeting strong { color: var(--text-primary); font-weight: 700; }

        /* ==================== کارت‌ها ==================== */
        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }
        .card-wrap {
            position: relative;
            border-radius: 20px;
            padding: 1px;
            background: var(--card-border);
        }
        .card-wrap.full-width { grid-column: 1 / -1; }

        .card {
            background: var(--card-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--card-border);
            border-radius: 19px;
            padding: 20px 18px;
            position: relative;
            overflow: hidden;
            height: 100%;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1),
                        inset 0 1px 0 var(--glass-highlight);
        }

        .card-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent-bright);
            margin-bottom: 12px;
            box-shadow: 0 0 16px var(--accent-glow);
        }
        .card-icon svg { width: 20px; height: 20px; }

        .card-label {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 10px;
        }

        .card-value {
            font-size: 28px;
            font-weight: 900;
            line-height: 1.1;
            display: flex;
            align-items: baseline;
            gap: 5px;
            direction: ltr;
            flex-wrap: wrap;
        }
        .card-value .num { color: var(--text-primary); }
        .card-value .unit { font-size: 13px; font-weight: 600; color: var(--text-muted); }
        .card-value .unit-accent { color: var(--accent-bright); }

        .unlimited-line-1 {
            font-size: 26px;
            font-weight: 900;
            color: var(--accent-bright);
            line-height: 1.2;
            display: flex;
            align-items: baseline;
            gap: 8px;
            direction: ltr;
            text-shadow: 0 0 20px var(--accent-glow);
        }
        .unlimited-line-1 .infinity-symbol {
            font-size: 36px;
            line-height: 0.8;
        }
        .unlimited-line-2 {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-secondary);
            margin-top: 8px;
            direction: ltr;
        }
        .unlimited-line-2 .used-num {
            color: var(--accent-bright);
            font-size: 16px;
            font-weight: 900;
        }

        .simple-progress {
            position: relative;
            height: 8px;
            border-radius: 8px;
            background: var(--ring-bg);
            overflow: hidden;
            margin-top: 14px;
        }
        .simple-progress-fill {
            height: 100%;
            border-radius: 8px;
            background: linear-gradient(90deg, var(--accent), var(--accent-bright));
            box-shadow: 0 0 12px var(--accent-glow);
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
            width: 0%;
        }
        .simple-progress.unlimited .simple-progress-fill {
            width: 100% !important;
            background: linear-gradient(90deg,
                var(--accent),
                var(--accent-bright),
                #0ea5e9,
                var(--accent-bright),
                var(--accent),
                var(--accent-bright),
                var(--accent)
            );
            background-size: 300% 100%;
            animation: unlimitedSlide 3s linear infinite;
        }
        @keyframes unlimitedSlide {
            0% { background-position: 0% 0; }
            100% { background-position: 300% 0; }
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            gap: 6px;
            flex-wrap: wrap;
        }
        .progress-info .highlight {
            color: var(--accent-bright);
            font-weight: 700;
        }

        .time-remaining {
            margin-top: 12px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--accent-bright);
            text-align: center;
            padding: 9px 10px;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            border-radius: 10px;
            box-shadow: inset 0 1px 0 var(--glass-highlight);
        }
        .expiry-box {
            margin-top: 8px;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-secondary);
            text-align: center;
            padding: 8px 10px;
            background: var(--card-bg-inner);
            border: 1px solid var(--card-border);
            border-radius: 10px;
            box-shadow: inset 0 1px 0 var(--glass-highlight);
        }
        .expiry-box strong {
            color: var(--accent-bright);
            font-weight: 700;
        }

        /* ==================== راهنما ==================== */
        .guide-text {
            font-size: 12px;
            line-height: 2;
            color: var(--text-secondary);
        }
        .guide-text p { margin-bottom: 10px; }
        .guide-text .guide-title {
            color: var(--accent-bright);
            font-weight: 800;
            margin-bottom: 4px;
            display: block;
        }
        .guide-text .guide-note {
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            border-radius: 8px;
            padding: 8px 10px;
            margin: 10px 0;
            font-size: 11px;
            line-height: 1.7;
            box-shadow: inset 0 1px 0 var(--glass-highlight);
        }

        .support-inline-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            margin-top: 12px;
            width: 100%;
            transition: transform 0.2s;
            box-shadow: 0 4px 16px var(--accent-glow);
        }
        .support-inline-btn:hover { transform: translateY(-2px); }
        .support-inline-btn svg { width: 18px; height: 18px; }

        /* ==================== آیکون اپ‌ها ==================== */
        .app-links-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-top: 12px;
        }
        .app-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 12px 6px;
            background: var(--card-bg-inner);
            backdrop-filter: blur(10px);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 9px;
            font-weight: 700;
            text-align: center;
            transition: all 0.2s ease;
            cursor: pointer;
            box-shadow: inset 0 1px 0 var(--glass-highlight);
        }
        .app-btn svg {
            width: 22px;
            height: 22px;
            stroke: var(--accent-bright);
            transition: stroke 0.2s;
            filter: drop-shadow(0 0 6px var(--accent-glow));
        }
        .app-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            border-color: var(--accent-bright);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px var(--accent-glow);
        }
        .app-btn:hover svg { stroke: #ffffff; filter: none; }

        /* ==================== فوتر ==================== */
        .footer {
            text-align: center;
            margin-top: 28px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-secondary);
            letter-spacing: 0.5px;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }
        .footer .brand-footer {
            color: var(--accent-bright);
            font-weight: 900;
        }

        /* ==================== Toast ==================== */
        .app-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--card-bg);
