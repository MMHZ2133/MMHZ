<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VaslPlus | __USER_NAME__</title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent: #e11d2e;
            --accent-bright: #ff2338;
            --accent-glow: rgba(225, 29, 46, 0.4);
            --accent-soft: rgba(225, 29, 46, 0.12);
            --accent-border: rgba(225, 29, 46, 0.35);
            --bg-primary: #0a0a0f;
            --bg-card: #14141c;
            --text-primary: #ffffff;
            --text-muted: #5a5a6e;
            --text-secondary: #a0a0b0;
            --border: #23232f;
            --ring-bg: #23232f;
            --gradient-accent: linear-gradient(135deg, #e11d2e 0%, #ff2338 100%);
            --gradient-silver: linear-gradient(135deg, #ffffff 0%, #b8b8c8 100%);
        }
        html.light {
            --accent: #16a34a;
            --accent-bright: #22c55e;
            --accent-glow: rgba(22, 163, 74, 0.35);
            --accent-soft: rgba(22, 163, 74, 0.12);
            --accent-border: rgba(22, 163, 74, 0.35);
            --bg-primary: #f5f7f5;
            --bg-card: #ffffff;
            --text-primary: #14532d;
            --text-muted: #9ca3af;
            --text-secondary: #4b5563;
            --border: #e5e7eb;
            --ring-bg: #e5e7eb;
            --gradient-accent: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
            --gradient-silver: linear-gradient(135deg, #14532d 0%, #166534 100%);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Vazirmatn', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            padding: 24px 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.4s, color 0.4s;
        }
        .container { width: 100%; max-width: 640px; }

        /* Top Controls */
        .top-controls {
            position: fixed;
            top: 20px;
            left: 20px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }
        .ctrl-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 14px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text-secondary);
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }
        .ctrl-btn:hover {
            border-color: var(--accent);
            color: var(--accent-bright);
            transform: translateY(-2px);
        }

        /* Logo */
        .logo-header { text-align: center; margin-bottom: 36px; }
        .logo-mark {
            width: 72px;
            height: 72px;
            margin: 0 auto 14px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-card);
            border: 2px solid var(--accent);
            box-shadow: 0 0 30px var(--accent-glow);
        }
        .logo-mark svg { width: 38px; height: 38px; }
        .brand-name {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            direction: ltr;
        }
        .brand-name .vasl {
            background: var(--gradient-silver);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .brand-name .plus {
            color: var(--accent-bright);
            text-shadow: 0 0 20px var(--accent-glow);
        }
        .brand-tagline {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 3px;
            color: var(--text-muted);
            margin-top: 6px;
            direction: ltr;
        }
        .brand-tagline span { color: var(--accent); margin: 0 6px; }

        /* User Greeting */
        .user-greeting {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 24px;
            font-size: 14px;
            color: var(--text-secondary);
        }
        .user-greeting strong { color: var(--text-primary); font-weight: 700; }

        /* Cards Grid */
        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px 22px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
        }
        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: var(--gradient-accent);
            opacity: 0.7;
        }
        .card:hover {
            border-color: var(--accent-border);
            transform: translateY(-4px);
            box-shadow: 0 8px 32px var(--accent-glow);
        }
        .card-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent-bright);
            margin-bottom: 16px;
        }
        .card-icon svg { width: 20px; height: 20px; }
        .card-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 10px;
        }
        .card-value {
            font-size: 30px;
            font-weight: 900;
            line-height: 1;
            display: flex;
            align-items: baseline;
            gap: 5px;
            direction: ltr;
            flex-wrap: wrap;
        }
        .card-value .num { color: var(--text-primary); }
        .card-value .unit { font-size: 13px; font-weight: 600; color: var(--text-muted); }
        .card-value .unit-accent { color: var(--accent-bright); }
        .card-value .infinity {
            font-size: 42px;
            font-weight: 900;
            color: var(--accent-bright);
            text-shadow: 0 0 20px var(--accent-glow);
            line-height: 0.8;
        }
        .card-value .infinity-text {
            font-size: 18px;
            font-weight: 700;
            color: var(--accent-bright);
            margin-right: 6px;
        }

        /* Progress Bars (کلاس‌هایی که پنل استفاده می‌کنه) */
        .progress-bar-bg {
            background: var(--ring-bg);
        }
        .progress-bar-bg > div {
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .text-muted { color: var(--text-muted); }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .mt-2 { margin-top: 8px; }
        .mt-3 { margin-top: 12px; }
        .mt-1\.5 { margin-top: 6px; }
        .text-\[10px\] { font-size: 10px; }

        /* Days Ring */
        .days-ring {
            margin-top: 16px;
            display: flex;
            gap: 4px;
        }
        .day-seg {
            flex: 1;
            height: 6px;
            border-radius: 4px;
            background: var(--ring-bg);
            transition: all 0.4s;
        }
        .day-seg.active {
            background: var(--gradient-accent);
            box-shadow: 0 0 8px var(--accent-glow);
        }

        /* Footer */
        .footer {
            text-align: center;
            margin-top: 28px;
            font-size: 11px;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            direction: ltr;
            font-weight: 600;
        }
        .footer .dot { color: var(--accent); margin: 0 6px; }

        /* Animations */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate { animation: fadeInUp 0.6s ease forwards; opacity: 0; }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        @media (max-width: 600px) {
            body { padding: 60px 12px 16px; }
            .top-controls { top: 12px; left: 12px; }
            .cards-grid { grid-template-columns: 1fr; gap: 14px; }
            .card { padding: 22px 20px; }
            .card-value { font-size: 28px; }
            .brand-name { font-size: 22px; }
        }
    </style>
</head>
<body>

    <!-- Top Controls -->
    <div class="top-controls">
        <button class="ctrl-btn" onclick="toggleLang()">
            <span id="lang-flag">🇮🇷</span>
            <span id="lang-text">FA</span>
        </button>
        <button class="ctrl-btn" onclick="toggleTheme()">
            <span id="theme-icon">🌙</span>
        </button>
    </div>

    <div class="container">

        <!-- Logo -->
        <div class="logo-header animate delay-1">
            <div class="logo-mark">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 4 L10 20 L14 20 L20 4 L16 4 L12 15 L8 4 Z" fill="url(#silverGrad)"/>
                    <path class="logo-swoosh" d="M3 8 Q12 16 21 6" stroke="#ff2338" stroke-width="2" fill="none" stroke-linecap="round"/>
                    <circle class="logo-globe" cx="19" cy="5" r="2.5" stroke="#ff2338" stroke-width="1.2" fill="none"/>
                    <defs>
                        <linearGradient id="silverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#ffffff"/>
                            <stop offset="100%" stop-color="#b8b8c8"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <div class="brand-name">
                <span class="vasl">Vasl</span><span class="plus">Plus</span>
            </div>
            <div class="brand-tagline">FAST <span>•</span> SECURE <span>•</span> GLOBAL</div>
        </div>

        <!-- User Greeting -->
        <div class="user-greeting animate delay-2">
            <span data-i18n="greeting">به پنلت خوش اومدی</span> <strong>__USER_NAME__</strong>
        </div>

        <!-- Cards Grid -->
        <div class="cards-grid">

            <!-- ===== حجم مصرفی ===== -->
            <div class="card animate delay-3">
                <div class="card-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7z"/>
                        <path d="M8 12h8"/>
                    </svg>
                </div>
                <div class="card-label" data-i18n="used_label">حجم مصرف‌شده</div>
                <div class="card-value" id="usage-value-container">
                    <!-- JS اینجا رو پر می‌کنه -->
                </div>
                <div id="usage-progress-container">
                    <!-- پنل با __TOTAL_PROGRESS__ اینجا رو پر می‌کنه -->
                    __TOTAL_PROGRESS__
                </div>
            </div>

            <!-- ===== روزهای باقی‌مانده ===== -->
            <div class="card animate delay-4">
                <div class="card-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </div>
                <div class="card-label" data-i18n="days_label">روزهای باقی‌مانده</div>
                <div class="card-value" id="days-value-container"></div>
                <div class="days-ring" id="days-ring"></div>
                <div class="text-\[10px\] text-muted mt-3">
                    <span data-i18n="expiry_label">تاریخ انقضا:</span>
                    <span id="expiry-date" style="color: var(--accent-bright); font-weight: 700;"></span>
                </div>
            </div>

        </div>

               <!-- Footer -->
        <div class="footer animate delay-4">
            <span class="blink-text">پنل کاربری وصل پلاس</span>
        </div>

    </div>

    <script>
        // =====================================================
        // 📌 داده‌هایی که پنل پر کرده
        // =====================================================
        const DATA = {
            userName: "__USER_NAME__",
            userId: "__USER_ID__",
            statusCode: "__STATUS_CODE__",
            totalGb: "__TOTAL_GB__",
            limitTotalGb: "__LIMIT_TOTAL_GB__",
            totalPercent: "__TOTAL_PERCENT__",
            dailyGb: "__DAILY_GB__",
            limitDailyGb: "__LIMIT_DAILY_GB__",
            dailyPercent: "__DAILY_PERCENT__",
            expiryDate: "__EXPIRY_DATE__"
        };

        // تشخیص نامحدود بودن
        const isUnlimitedGB = DATA.limitTotalGb === "9999" || 
                              DATA.limitTotalGb === "Unlimited" ||
                              parseFloat(DATA.limitTotalGb) >= 9999;

        const isUnlimitedDays = !DATA.expiryDate || 
                                DATA.expiryDate === "2099-01-01" ||
                                DATA.expiryDate === "Never Expire";

        // =====================================================
        // 🌐 ترجمه‌ها
        // =====================================================
        const I18N = {
            fa: {
                greeting: "به پنلت خوش اومدی",
                used_label: "حجم به فنا رفته",
                days_label: "هنوز وقت هست ستون",
                days_unit: "شبانه روز",
                expiry_label: "تاریخ قطع شدنش",
                unlimited: "حجم نامحدوده مصرف کن و لذت ببر",
                expired: "عمرش تموم شد برو تمدید کن",
                no_expiry: "تا هروقت دلت میخواد",
            },
            en: {
                greeting: "Welcome,",
                used_label: "Data Used",
                days_label: "Days Remaining",
                days_unit: "days",
                expiry_label: "Expiry date:",
                unlimited: "Unlimited",
                expired: "Expired",
                no_expiry: "No expiry"
            }
        };

        let currentLang = localStorage.getItem("vp_lang") || "fa";
        let currentTheme = localStorage.getItem("vp_theme") || "dark";

        const $ = (id) => document.getElementById(id);

        // =====================================================
        // 🔢 فرمت عدد
        // =====================================================
        function formatNumber(num, maxDecimals = 2) {
            if (!isFinite(num) || num === 0) return "0";
            const rounded = Math.round(num * Math.pow(10, maxDecimals)) / Math.pow(10, maxDecimals);
            if (rounded === Math.floor(rounded)) return rounded.toString();
            return parseFloat(rounded.toFixed(maxDecimals)).toString();
        }

        // =====================================================
        // 📅 محاسبه‌ی دقیق روزها
        // =====================================================
        function calcDaysLeft(expiryStr) {
            if (!expiryStr || expiryStr === "Never Expire" || expiryStr === "2099-01-01") {
                return { days: 0, expired: false, valid: false };
            }

            let expiry = null;
            if (/^\d{4}-\d{1,2}-\d{1,2}/.test(expiryStr)) {
                expiry = new Date(expiryStr);
            } else if (/^\d+$/.test(expiryStr)) {
                const num = parseInt(expiryStr);
                expiry = new Date(num > 10000000000 ? num : num * 1000);
            } else {
                expiry = new Date(expiryStr);
            }

            if (!expiry || isNaN(expiry.getTime())) {
                return { days: 0, expired: false, valid: false };
            }

            const now = new Date();
            const diffMs = expiry.getTime() - now.getTime();

            if (diffMs <= 0) {
                return { days: 0, expired: true, valid: true };
            }

            const totalHours = diffMs / (1000 * 60 * 60);
            const fullDays = Math.floor(totalHours / 24);
            const remainingHours = totalHours % 24;
            const days = remainingHours > 0 ? fullDays + 1 : fullDays;

            return { days: Math.max(0, days), expired: false, valid: true };
        }

        // =====================================================
        // 📅 فرمت تاریخ
        // =====================================================
        function toLocaleDate(dateStr, lang) {
            if (!dateStr || dateStr === "Never Expire" || dateStr === "2099-01-01") return "—";
            try {
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return "—";
                const locale = lang === "fa" ? "fa-IR" : "en-GB";
                return d.toLocaleDateString(locale, {
                    year: 'numeric', month: '2-digit', day: '2-digit'
                });
            } catch (e) {
                return "—";
            }
        }

        // =====================================================
        // 🌐 تغییر زبان
        // =====================================================
        function applyLang() {
            const t = I18N[currentLang];
            document.documentElement.lang = currentLang;
            document.documentElement.dir = currentLang === "fa" ? "rtl" : "ltr";

            document.querySelectorAll("[data-i18n]").forEach(el => {
                const key = el.getAttribute("data-i18n");
                if (t[key]) el.textContent = t[key];
            });

            $("lang-flag").textContent = currentLang === "fa" ? "🇮🇷" : "🇬🇧";
            $("lang-text").textContent = currentLang === "fa" ? "FA" : "EN";

            render();
        }

        function toggleLang() {
            currentLang = currentLang === "fa" ? "en" : "fa";
            localStorage.setItem("vp_lang", currentLang);
            applyLang();
        }

        // =====================================================
        // 🌙/☀️ تغییر تم
        // =====================================================
        function applyTheme() {
            document.documentElement.classList.toggle("light", currentTheme === "light");
            $("theme-icon").textContent = currentTheme === "dark" ? "🌙" : "☀️";
        }

        function toggleTheme() {
            currentTheme = currentTheme === "dark" ? "light" : "dark";
            localStorage.setItem("vp_theme", currentTheme);
            applyTheme();
        }

        // =====================================================
        // 📊 رندر
        // =====================================================
        function render() {
            const t = I18N[currentLang];
            const usageContainer = $("usage-value-container");
            const daysContainer = $("days-value-container");
            const ring = $("days-ring");

            // ==========================================
            // حجم مصرفی
            // ==========================================
            if (isUnlimitedGB) {
                usageContainer.innerHTML = `
                    <span class="infinity">∞</span>
                    <span class="infinity-text">${t.unlimited}</span>
                `;
            } else {
                const used = parseFloat(DATA.totalGb) || 0;
                const total = parseFloat(DATA.limitTotalGb) || 0;

                usageContainer.innerHTML = `
                    <span class="num">${formatNumber(used)}</span>
                    <span class="unit">/</span>
                    <span class="num">${formatNumber(total)}</span>
                    <span class="unit unit-accent">GB</span>
                `;
            }

            // ==========================================
            // روزهای باقی‌مانده
            // ==========================================
            if (isUnlimitedDays) {
                daysContainer.innerHTML = `
                    <span class="infinity">∞</span>
                    <span class="infinity-text">${t.unlimited}</span>
                `;
                $("expiry-date").textContent = t.no_expiry;
                ring.innerHTML = "";
                for (let i = 0; i < 7; i++) {
                    const seg = document.createElement("div");
                    seg.className = "day-seg active";
                    ring.appendChild(seg);
                }
            } else {
                const result = calcDaysLeft(DATA.expiryDate);

                if (result.expired) {
                    daysContainer.innerHTML = `
                        <span class="num">0</span>
                        <span class="unit unit-accent">${t.expired}</span>
                    `;
                } else {
                    daysContainer.innerHTML = `
                        <span class="num">${result.days}</span>
                        <span class="unit unit-accent">${t.days_unit}</span>
                    `;
                }

                $("expiry-date").textContent = toLocaleDate(DATA.expiryDate, currentLang);

                const daysLeft = result.days;
                const segments = 7;
                const filledSegments = daysLeft >= 30
                    ? segments
                    : Math.max(0, Math.round((daysLeft / 30) * segments));

                ring.innerHTML = "";
                for (let i = 0; i < segments; i++) {
                    const seg = document.createElement("div");
                    seg.className = "day-seg" + (i < filledSegments ? " active" : "");
                    ring.appendChild(seg);
                }
            }
        }

        // =====================================================
        // 🚀 راه‌اندازی
        // =====================================================
        (function init() {
            applyTheme();
            applyLang();
        })();
    </script>

</body>
</html>
