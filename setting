<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VaslPlus | __USER_NAME__</title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ==================== Root Variables ==================== */
        :root {
            --accent: #ff2338;
            --accent-bright: #ff4d5e;
            --accent-glow: rgba(255, 35, 56, 0.4);
            --accent-soft: rgba(255, 35, 56, 0.12);
            --accent-border: rgba(255, 35, 56, 0.35);
            --bg-primary: #0a0a0f;
            --bg-card: rgba(20, 20, 28, 0.7);
            --text-primary: #ffffff;
            --text-muted: #6b6b80;
            --text-secondary: #a0a0b0;
            --border: #23232f;
            --ring-bg: #23232f;
            --gradient-accent: linear-gradient(135deg, #ff2338 0%, #ff4d5e 100%);
            --gradient-silver: linear-gradient(135deg, #ffffff 0%, #b8b8c8 100%);
            --fib1: #ff2338;
            --fib2: #ff6b35;
            --fib3: #ffd700;
        }

        html.light {
            --accent: #0d6efd;
            --accent-bright: #3b82f6;
            --accent-glow: rgba(13, 110, 253, 0.35);
            --accent-soft: rgba(13, 110, 253, 0.12);
            --accent-border: rgba(13, 110, 253, 0.35);
            --bg-primary: #f0f6ff;
            --bg-card: rgba(255, 255, 255, 0.75);
            --text-primary: #0a2540;
            --text-muted: #94a3b8;
            --text-secondary: #475569;
            --border: #dbeafe;
            --ring-bg: #dbeafe;
            --gradient-accent: linear-gradient(135deg, #0d6efd 0%, #3b82f6 100%);
            --gradient-silver: linear-gradient(135deg, #0a2540 0%, #1e40af 100%);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            font-family: 'Vazirmatn', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            transition: background 0.5s, color 0.5s;
        }

        /* ==================== Fiber Optic Background (Light) ==================== */
        .fiber-bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }
        .fiber-bg svg {
            width: 100%;
            height: 100%;
            display: block;
        }
        .fiber-line {
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
        }
        .fiber-line.f1 { stroke: var(--fib1); animation: fiberPulse 5s ease-in-out infinite; }
        .fiber-line.f2 { stroke: var(--fib2); animation: fiberPulse 6s ease-in-out infinite 1s; }
        .fiber-line.f3 { stroke: var(--fib3); animation: fiberPulse 5.5s ease-in-out infinite 2s; }
        @keyframes fiberPulse {
            0%, 100% { opacity: 0.18; }
            50% { opacity: 0.7; }
        }
        .fiber-particle {
            fill: var(--fib1);
            filter: drop-shadow(0 0 5px currentColor);
        }
        .fiber-particle.p2 { fill: var(--fib2); }

        /* ==================== Top Controls ==================== */
        .top-controls {
            position: fixed;
            top: 20px;
            left: 20px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }
        .ctrl-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 9px 14px;
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text-secondary);
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }
        .ctrl-btn:hover {
            border-color: var(--accent);
            color: var(--accent-bright);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px var(--accent-glow);
        }
        .ctrl-btn svg { width: 18px; height: 18px; }

        .ctrl-btn.support-btn {
            background: linear-gradient(135deg, #0088cc 0%, #00a8e8 100%);
            border-color: #0088cc;
            color: #ffffff;
            padding: 9px 12px;
        }
        .ctrl-btn.support-btn:hover {
            box-shadow: 0 8px 24px rgba(0, 136, 204, 0.5);
            border-color: #00a8e8;
            color: #ffffff;
        }

        /* ==================== Container ==================== */
        .container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 640px;
            margin: 0 auto;
            padding: 100px 16px 24px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* ==================== Logo with RGB Ring ==================== */
        .logo-header { text-align: center; margin-bottom: 36px; }

        .logo-ring {
            position: relative;
            width: 92px;
            height: 92px;
            margin: 0 auto 16px;
            border-radius: 50%;
            padding: 3px;
            background: conic-gradient(
                from 0deg,
                #ff0000, #ff8000, #ffff00, #00ff00,
                #00ffff, #0080ff, #8000ff, #ff00ff, #ff0000
            );
            animation: rgbRotate 4s linear infinite;
            box-shadow: 0 0 25px rgba(255, 0, 128, 0.3),
                        0 0 50px rgba(0, 128, 255, 0.2);
        }
        @keyframes rgbRotate {
            from { filter: hue-rotate(0deg); }
            to { filter: hue-rotate(360deg); }
        }
        .logo-mark {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-primary);
            position: relative;
        }
        .logo-mark svg { width: 44px; height: 44px; }
        .logo-mark .logo-swoosh { stroke: var(--accent-bright); }

        .brand-name {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            direction: ltr;
        }
        .brand-name .vasl {
            background: var(--gradient-silver);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .brand-name .plus {
            color: var(--accent-bright);
            text-shadow: 0 0 20px var(--accent-glow);
        }
        .brand-tagline {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 3px;
            color: var(--text-muted);
            margin-top: 6px;
            direction: ltr;
        }
        .brand-tagline span { color: var(--accent); margin: 0 6px; }

        /* ==================== User Greeting ==================== */
        .user-greeting {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 24px;
            font-size: 14px;
            color: var(--text-secondary);
        }
        .user-greeting strong { color: var(--text-primary); font-weight: 700; }

        /* ==================== Cards ==================== */
        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        .card {
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px 22px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
        }
        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg,
                #ff0000, #ff8000, #ffff00, #00ff00,
                #00ffff, #0080ff, #8000ff, #ff00ff, #ff0000);
            background-size: 200% 100%;
            animation: rgbSlide 3s linear infinite;
        }
        @keyframes rgbSlide {
            from { background-position: 0% 0; }
            to { background-position: 200% 0; }
        }
        .card:hover {
            border-color: var(--accent-border);
            transform: translateY(-4px);
            box-shadow: 0 8px 32px var(--accent-glow);
        }
        .card-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent-bright);
            margin-bottom: 16px;
        }
        .card-icon svg { width: 20px; height: 20px; }
        .card-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 10px;
        }
        .card-value {
            font-size: 30px;
            font-weight: 900;
            line-height: 1;
            display: flex;
            align-items: baseline;
            gap: 5px;
            direction: ltr;
            flex-wrap: wrap;
        }
        .card-value .num { color: var(--text-primary); }
        .card-value .unit { font-size: 13px; font-weight: 600; color: var(--text-muted); }
        .card-value .unit-accent { color: var(--accent-bright); }
        .card-value .infinity {
            font-size: 42px;
            font-weight: 900;
            color: var(--accent-bright);
            text-shadow: 0 0 20px var(--accent-glow);
            line-height: 0.8;
        }
        .card-value .infinity-text {
            font-size: 18px;
            font-weight: 700;
            color: var(--accent-bright);
            margin-right: 6px;
        }

        /* ==================== RGB Progress Bars (هم برای حجم هم مهلت) ==================== */
        .rgb-progress {
            position: relative;
            height: 8px;
            border-radius: 8px;
            background: var(--ring-bg);
            overflow: hidden;
            margin-top: 16px;
        }
        .rgb-progress-fill {
            height: 100%;
            border-radius: 8px;
            background: linear-gradient(90deg,
                #ff0000, #ff8000, #ffff00, #00ff00,
                #00ffff, #0080ff, #8000ff, #ff00ff, #ff0000);
            background-size: 300% 100%;
            animation: rgbSlide 3s linear infinite;
            box-shadow: 0 0 12px rgba(255, 0, 128, 0.5);
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            width: 0%;
        }
        .rgb-progress-fill::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
            animation: shimmer 2s infinite;
        }
        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            gap: 8px;
            flex-wrap: wrap;
        }
        .progress-info .highlight {
            color: var(--accent-bright);
            font-weight: 700;
        }

        /* ==================== Footer with Blink ==================== */
        .footer {
            text-align: center;
            margin-top: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .footer .blink-text {
            font-weight: 900;
            font-size: 15px;
            letter-spacing: 1.5px;
            transition: color 0.3s;
        }

        /* روز: قرمز */
        html.light .footer .blink-text {
            animation: redBlink 1.2s ease-in-out infinite;
        }
        @keyframes redBlink {
            0%, 100% {
                color: #dc2626;
                text-shadow: 0 0 14px rgba(220, 38, 38, 0.8),
                             0 0 28px rgba(220, 38, 38, 0.4);
            }
            50% {
                color: #ff6b35;
                text-shadow: 0 0 14px rgba(255, 107, 53, 0.8),
                             0 0 28px rgba(255, 107, 53, 0.4);
            }
        }

        /* شب: آبی */
        html:not(.light) .footer .blink-text {
            animation: blueBlink 1.2s ease-in-out infinite;
        }
        @keyframes blueBlink {
            0%, 100% {
                color: #3b82f6;
                text-shadow: 0 0 14px rgba(59, 130, 246, 0.8),
                             0 0 28px rgba(59, 130, 246, 0.4);
            }
            50% {
                color: #00d4ff;
                text-shadow: 0 0 14px rgba(0, 212, 255, 0.8),
                             0 0 28px rgba(0, 212, 255, 0.4);
            }
        }

        /* ==================== Animations ==================== */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate { animation: fadeInUp 0.6s ease forwards; opacity: 0; }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        /* ==================== Responsive ==================== */
        @media (max-width: 600px) {
            .top-controls { top: 12px; left: 12px; }
            .ctrl-btn { padding: 8px 10px; font-size: 11px; }
            .container { padding: 90px 12px 16px; }
            .cards-grid { grid-template-columns: 1fr; gap: 14px; }
            .card { padding: 22px 20px; }
            .card-value { font-size: 28px; }
            .brand-name { font-size: 22px; }
            .logo-ring { width: 80px; height: 80px; }
            .logo-mark svg { width: 36px; height: 36px; }
        }
    </style>
</head>
<body>

    <!-- ==================== Fiber Optic Background (سبک) ==================== -->
    <div class="fiber-bg">
        <svg viewBox="0 0 1200 800" preserveAspectRatio="none">
