<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VaslPlus | __USER_NAME__</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            /* تم شب - مشکی و قرمز */
            --accent: #ff2338;
            --accent-bright: #ff4d5e;
            --accent-glow: rgba(255, 35, 56, 0.4);
            --accent-soft: rgba(255, 35, 56, 0.12);
            --accent-border: rgba(255, 35, 56, 0.35);
            --bg-primary: #000000;
            --card-bg: #1a1a1a;
            --card-bg-inner: #0d0d0d;
            --text-primary: #ffffff;
            --text-muted: #6b6b80;
            --text-secondary: #a0a0b0;
            --border: #2a2a2a;
            --ring-bg: #2a2a2a;
            --gradient-silver: linear-gradient(135deg, #ffffff 0%, #b8b8c8 100%);
        }

        html.light {
            /* تم روز - سفید و آبی */
            --accent: #0d6efd;
            --accent-bright: #3b82f6;
            --accent-glow: rgba(13, 110, 253, 0.35);
            --accent-soft: rgba(13, 110, 253, 0.10);
            --accent-border: rgba(13, 110, 253, 0.30);
            --bg-primary: #ffffff;
            --card-bg: #f8fbff;
            --card-bg-inner: #ffffff;
            --text-primary: #0a2540;
            --text-muted: #94a3b8;
            --text-secondary: #475569;
            --border: #e5eefb;
            --ring-bg: #dbeafe;
            --gradient-silver: linear-gradient(135deg, #0a2540 0%, #1e40af 100%);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            font-family: 'Vazirmatn', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            transition: background 0.3s, color 0.3s;
        }

        /* ==================== Modal ==================== */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            z-index: 999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 1;
            transition: opacity 0.4s;
        }
        .modal-overlay.hidden { display: none; }

        .modal-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 28px 24px;
            max-width: 480px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
            animation: modalIn 0.4s ease;
            max-height: 90vh;
            overflow-y: auto;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.95) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .modal-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 2px solid var(--accent-border);
            color: var(--accent-bright);
        }
        .modal-icon svg { width: 30px; height: 30px; }

        .modal-title {
            font-size: 17px;
            font-weight: 800;
            color: var(--accent-bright);
            text-align: center;
            margin-bottom: 14px;
        }

        .modal-text {
            font-size: 13px;
            line-height: 1.9;
            color: var(--text-secondary);
            text-align: center;
            margin-bottom: 18px;
        }
        .modal-text p { margin-bottom: 8px; }
        .modal-text .thanks {
            color: var(--accent-bright);
            font-weight: 700;
            font-size: 13px;
            margin-top: 12px;
        }

        .modal-checkbox {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 18px;
            font-size: 12px;
            color: var(--text-muted);
            cursor: pointer;
        }
        .modal-checkbox input {
            width: 16px;
            height: 16px;
            accent-color: var(--accent);
            cursor: pointer;
        }

        .modal-btn {
            width: 100%;
            padding: 13px;
            background: var(--accent);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s;
        }
        .modal-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        /* ==================== Top Controls ==================== */
        .top-controls {
            position: fixed;
            top: 20px;
            left: 20px;
            display: flex;
            gap: 8px;
            z-index: 100;
        }
        .ctrl-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 9px 12px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text-secondary);
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }
        .ctrl-btn:hover {
            border-color: var(--accent);
            color: var(--accent-bright);
            transform: translateY(-2px);
        }
        .ctrl-btn svg { width: 18px; height: 18px; }
        .ctrl-btn.support-btn { padding: 8px; }
        .ctrl-btn.support-btn svg { width: 22px; height: 22px; }

        /* ==================== Container ==================== */
        .container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 640px;
            margin: 0 auto;
            padding: 100px 16px 24px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* ==================== Logo ==================== */
        .logo-header { text-align: center; margin-bottom: 28px; }

        .logo-ring {
            position: relative;
            width: 88px;
            height: 88px;
            margin: 0 auto 14px;
            border-radius: 50%;
            padding: 3px;
            background: var(--accent);
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .logo-mark {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--card-bg);
        }
        .logo-mark svg { width: 42px; height: 42px; }
        .logo-mark .logo-swoosh { stroke: var(--accent-bright); }

        .brand-name {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            direction: ltr;
        }
        .brand-name .vasl {
            background: var(--gradient-silver);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .brand-name .plus { color: var(--accent-bright); }
        .brand-tagline {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 3px;
            color: var(--text-muted);
            margin-top: 6px;
            direction: ltr;
        }
        .brand-tagline span { color: var(--accent); margin: 0 6px; }

        /* ==================== Greeting ==================== */
        .user-greeting {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            color: var(--text-secondary);
        }
        .user-greeting strong { color: var(--text-primary); font-weight: 700; }

        /* ==================== Cards Grid ==================== */
        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .card-wrap {
            position: relative;
            border-radius: 16px;
            padding: 2px;
            background: var(--border);
            border: 1px solid var(--border);
        }
        .card-wrap.full-width { grid-column: 1 / -1; }

        .card {
            background: var(--card-bg);
            border-radius: 14px;
            padding: 20px 18px;
            position: relative;
            overflow: hidden;
            height: 100%;
        }

        .card-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent-bright);
            margin-bottom: 12px;
        }
        .card-icon svg { width: 20px; height: 20px; }

        .card-label {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 10px;
        }

        /* ==================== Card Values ==================== */
        .card-value {
            font-size: 28px;
            font-weight: 900;
            line-height: 1.1;
            display: flex;
            align-items: baseline;
            gap: 5px;
            direction: ltr;
            flex-wrap: wrap;
        }
        .card-value .num { color: var(--text-primary); }
        .card-value .unit { font-size: 13px; font-weight: 600; color: var(--text-muted); }
        .card-value .unit-accent { color: var(--accent-bright); }

        /* ==================== Unlimited Layout ==================== */
        .unlimited-line-1 {
            font-size: 26px;
            font-weight: 900;
            color: var(--accent-bright);
            line-height: 1.2;
            display: flex;
            align-items: baseline;
            gap: 8px;
            direction: ltr;
        }
        .unlimited-line-1 .infinity-symbol {
            font-size: 36px;
            line-height: 0.8;
        }
        .unlimited-line-2 {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-secondary);
            margin-top: 8px;
            direction: ltr;
        }
        .unlimited-line-2 .used-num {
            color: var(--accent-bright);
            font-size: 16px;
            font-weight: 900;
        }

        /* ==================== Simple Progress ==================== */
        .simple-progress {
            position: relative;
            height: 8px;
            border-radius: 8px;
            background: var(--ring-bg);
            overflow: hidden;
            margin-top: 14px;
        }
        .simple-progress-fill {
            height: 100%;
            border-radius: 8px;
            background: var(--accent);
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
            width: 0%;
        }

        /* نوار متحرک برای نامحدود */
        .simple-progress.unlimited .simple-progress-fill {
            width: 40% !important;
            background: linear-gradient(90deg,
                transparent,
                var(--accent),
                var(--accent-bright),
                var(--accent),
                transparent);
            background-size: 200% 100%;
            animation: unlimitedSlide 2s linear infinite;
            border-radius: 8px;
        }
        @keyframes unlimitedSlide {
            0% { background-position: -100% 0; }
            100% { background-position: 200% 0; }
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            gap: 6px;
            flex-wrap: wrap;
        }
        .progress-info .highlight {
            color: var(--accent-bright);
            font-weight: 700;
        }

        .time-remaining {
            margin-top: 12px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--accent-bright);
            text-align: center;
            padding: 9px 10px;
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            border-radius: 10px;
        }

        .expiry-box {
            margin-top: 8px;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-secondary);
            text-align: center;
            padding: 8px 10px;
            background: var(--card-bg-inner);
            border: 1px solid var(--border);
            border-radius: 10px;
        }
        .expiry-box strong {
            color: var(--accent-bright);
            font-weight: 700;
        }

        /* ==================== Guide ==================== */
        .guide-text {
            font-size: 12px;
            line-height: 2;
            color: var(--text-secondary);
        }
        .guide-text p { margin-bottom: 10px; }
        .guide-text .guide-title {
            color: var(--accent-bright);
            font-weight: 800;
            margin-bottom: 4px;
            display: block;
        }
        .guide-text .guide-note {
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            border-radius: 8px;
            padding: 8px 10px;
            margin: 10px 0;
            font-size: 11px;
            line-height: 1.7;
        }
        .guide-text .guide-warn {
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px dashed var(--border);
        }

        .support-inline-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            background: linear-gradient(135deg, #0088cc, #00a8e8);
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            margin-top: 12px;
            width: 100%;
            transition: transform 0.2s;
        }
        .support-inline-btn:hover { transform: translateY(-2px); }
        .support-inline-btn svg { width: 18px; height: 18px; }

        /* ==================== App Links ==================== */
        .app-links-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-top: 12px;
        }

        .app-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 12px 6px;
            background: var(--card-bg-inner);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 9px;
            font-weight: 700;
            text-align: center;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .app-btn svg {
            width: 22px;
            height: 22px;
            stroke: var(--accent-bright);
            transition: stroke 0.2s;
        }
        .app-btn:hover {
            background: var(--accent);
            border-color: var(--accent-bright);
            color: #ffffff;
            transform: translateY(-2px);
        }
        .app-btn:hover svg { stroke: #ffffff; }

        /* ==================== Footer ==================== */
        .footer {
            text-align: center;
            margin-top: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .footer .blink-text {
            font-weight: 900;
            font-size: 15px;
            letter-spacing: 1.5px;
        }

        html.light .footer .blink-text {
            animation: redBlink 1.2s ease-in-out infinite;
        }
        @keyframes redBlink {
            0%, 100% { color: #dc2626; text-shadow: 0 0 14px rgba(220, 38, 38, 0.6); }
            50% { color: #ff6b35; text-shadow: 0 0 14px rgba(255, 107, 53, 0.6); }
        }
        html:not(.light) .footer .blink-text {
            animation: blueBlink 1.2s ease-in-out infinite;
        }
        @keyframes blueBlink {
            0%, 100% { color: #3b82f6; text-shadow: 0 0 14px rgba(59, 130, 246, 0.6); }
            50% { color: #00d4ff; text-shadow: 0 0 14px rgba(0, 212, 255, 0.6); }
        }

        /* ==================== Toast ==================== */
        .app-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--card-bg);
            color: var(--text-primary);
            padding: 12px 22px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            z-index: 9999;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.25);
            border: 1px solid var(--border);
            opacity: 0;
            transition: opacity 0.3s, transform 0.3s;
            pointer-events: none;
            max-width: 90%;
            text-align: center;
        }
        .app-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate { animation: fadeInUp 0.5s ease forwards; opacity: 0; }
        .delay-1 { animation-delay: 0.08s; }
        .delay-2 { animation-delay: 0.16s; }
        .delay-3 { animation-delay: 0.24s; }
        .delay-4 { animation-delay: 0.32s; }
        .delay-5 { animation-delay: 0.4s; }
        .delay-6 { animation-delay: 0.48s; }

        @media (max-width: 600px) {
            .top-controls { top: 12px; left: 12px; }
            .ctrl-btn { padding: 8px 10px; font-size: 11px; }
            .container { padding: 90px 12px 16px; }
            .cards-grid { grid-template-columns: 1fr; gap: 14px; }
            .card { padding: 18px 16px; }
            .card-value { font-size: 26px; }
            .brand-name { font-size: 22px; }
            .logo-ring { width: 78px; height: 78px; }
            .logo-mark svg { width: 36px; height: 36px; }
            .app-links-grid { grid-template-columns: repeat(3, 1fr); }
            .modal-card { padding: 22px 18px; }
        }
    </style>
</head>
<body>

    <!-- ==================== Welcome Modal ==================== -->
    <div class="modal-overlay" id="welcome-modal">
        <div class="modal-card">
            <div class="modal-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div class="modal-title" data-i18n="modal_title">خوش آمدید</div>
            <div class="modal-text">
                <p data-i18n="modal_greet">سلام و عرض ادب خدمت شما کاربر گرامی</p>
                <p data-i18n="modal_body">از اینکه وصل پلاس را انتخاب نموده‌اید، صمیمانه سپاسگزاریم.</p>
                <p data-i18n="modal_more">ما در تلاش هستیم تا با ارائه بهترین کیفیت و پشتیبانی، تجربه‌ای متفاوت برای شما فراهم کنیم.</p>
                <p data-i18n="modal_guide">لطفاً برای استفاده بهینه از امکانات، بخش راهنما را با دقت مطالعه فرمایید.</p>
                <div class="thanks" data-i18n="modal_thanks">با تشکر - تیم پشتیبانی وصل پلاس</div>
            </div>
            <label class="modal-checkbox">
                <input type="checkbox" id="dont-show-again">
                <span data-i18n="modal_checkbox">دیگر نشان نده</span>
            </label>
            <button class="modal-btn" onclick="closeWelcomeModal()" data-i18n="modal_btn">متوجه شدم، ادامه</button>
        </div>
    </div>

    <!-- ==================== Top Controls ==================== -->
    <div class="top-controls">
        <button class="ctrl-btn" onclick="toggleLang()" title="Change Language">
            <span id="lang-flag">🇮🇷</span>
            <span id="lang-text">FA</span>
        </button>
        <button class="ctrl-btn" onclick="toggleTheme()" title="Toggle Theme">
            <span id="theme-icon">🌙</span>
        </button>
        <a class="ctrl-btn support-btn" href="https://t.me/vaslplus_support1" target="_blank" title="پشتیبانی / Support">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 15V10a7 7 0 0 1 14 0v5"/>
                <path d="M5 15a2 2 0 0 0 2 2h1a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H5z"/>
                <path d="M19 15a2 2 0 0 1-2 2h-1a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h3z"/>
                <circle cx="12" cy="12" r="3"/>
                <path d="M14 13l2 1"/>
                <circle cx="16.5" cy="14.5" r="1"/>
            </svg>
        </a>
    </div>

    <div class="container">

        <!-- ==================== Logo ==================== -->
        <div class="logo-header animate delay-1">
            <div class="logo-ring">
                <div class="logo-mark">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4 4 L10 20 L14 20 L20 4 L16 4 L12 15 L8 4 Z" fill="url(#silverGrad)"/>
                        <path class="logo-swoosh" d="M3 8 Q12 16 21 6" stroke-width="2" fill="none" stroke-linecap="round"/>
                        <defs>
                            <linearGradient id="silverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#ffffff"/>
                                <stop offset="100%" stop-color="#b8b8c8"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>
            <div class="brand-name">
                <span class="vasl">Vasl</span><span class="plus">Plus</span>
            </div>
            <div class="brand-tagline">FAST <span>•</span> SECURE <span>•</span> GLOBAL</div>
        </div>

        <!-- ==================== Greeting ==================== -->
        <div class="user-greeting animate delay-2">
            <span data-i18n="greeting">خوش آمدی،</span> <strong>__USER_NAME__</strong>
        </div>

        <!-- ==================== Cards ==================== -->
        <div class="cards-grid">

            <!-- کارت حجم مصرفی -->
            <div class="card-wrap animate delay-3">
                <div class="card">
                    <div class="card-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7z"/>
                            <path d="M8 12h8"/>
                        </svg>
                    </div>
                    <div class="card-label" data-i18n="used_label">حجم مصرف‌شده</div>
                    <div class="card-value" id="usage-value-container"></div>
                    <div class="simple-progress" id="usage-progress-wrap">
                        <div class="simple-progress-fill" id="usage-progress"></div>
                    </div>
                    <div class="progress-info" id="usage-progress-info">
                        <span><span class="highlight" id="used-percent">0</span><span data-i18n="percent_used">٪ مصرف شده</span></span>
                        <span><span data-i18n="remaining">باقی‌مانده:</span> <span class="highlight" id="remaining-gb">0</span> <span data-i18n="gb_unit">GB</span></span>
                    </div>
