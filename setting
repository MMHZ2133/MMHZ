    <script>
        // ==================== Data ====================
        const DATA = {
            userName: "__USER_NAME__",
            userId: "__USER_ID__",
            statusCode: "__STATUS_CODE__",
            totalGb: "__TOTAL_GB__",
            limitTotalGb: "__LIMIT_TOTAL_GB__",
            totalPercent: "__TOTAL_PERCENT__",
            dailyGb: "__DAILY_GB__",
            limitDailyGb: "__LIMIT_DAILY_GB__",
            dailyPercent: "__DAILY_PERCENT__",
            expiryDate: "__EXPIRY_DATE__"
        };

        const isUnlimitedGB = DATA.limitTotalGb === "9999" ||
                              DATA.limitTotalGb === "Unlimited" ||
                              parseFloat(DATA.limitTotalGb) >= 9999;

        const isUnlimitedDays = !DATA.expiryDate ||
                                DATA.expiryDate === "2099-01-01" ||
                                DATA.expiryDate === "Never Expire";

        // ==================== i18n ====================
        const I18N = {
            fa: {
                greeting: "خوش آمدی،",
                used_label: "حجم مصرف‌شده",
                days_label: "روزهای باقی‌مانده",
                days_unit: "روز",
                percent_used: "٪ مصرف شده",
                remaining: "باقی‌مانده:",
                expiry_label: "تاریخ انقضا:",
                unlimited: "نامحدود",
                gb_unit: "GB",
                expired: "منقضی شده",
                no_expiry: "بدون انقضا",
                footer: "پنل کاربری وصل پلاس",
                app_links: "اتصال به برنامه‌ها",
                day: "روز",
                days: "روز",
                hour: "ساعت",
                hours: "ساعت",
                minute: "دقیقه",
                minutes: "دقیقه",
                and: "و",
                expired_text: "منقضی شده",
                remaining_prefix: "باقی‌مانده",
                copy_success_happ: "لینک کپی شد! توی Happ paste کن",
                copy_success_npv: "لینک کپی شد! توی NPV Tunnel paste کن",
                copy_error: "خطا در کپی لینک"
            },
            en: {
                greeting: "Welcome,",
                used_label: "Data Used",
                days_label: "Days Remaining",
                days_unit: "days",
                percent_used: "% used",
                remaining: "Remaining:",
                expiry_label: "Expiry date:",
                unlimited: "Unlimited",
                gb_unit: "GB",
                expired: "Expired",
                no_expiry: "No expiry",
                footer: "VaslPlus User Panel",
                app_links: "Connect to Apps",
                day: "day",
                days: "days",
                hour: "hour",
                hours: "hours",
                minute: "minute",
                minutes: "minutes",
                and: "and",
                expired_text: "Expired",
                remaining_prefix: "remaining",
                copy_success_happ: "Link copied! Paste in Happ",
                copy_success_npv: "Link copied! Paste in NPV Tunnel",
                copy_error: "Failed to copy link"
            }
        };

        let currentLang = localStorage.getItem("vp_lang") || "fa";
        let currentTheme = localStorage.getItem("vp_theme") || "dark";

        const $ = (id) => document.getElementById(id);

        // ==================== Format Number ====================
        function formatNumber(num, maxDecimals = 2) {
            if (!isFinite(num) || num === 0) return "0";
            const rounded = Math.round(num * Math.pow(10, maxDecimals)) / Math.pow(10, maxDecimals);
            if (rounded === Math.floor(rounded)) return rounded.toString();
            return parseFloat(rounded.toFixed(maxDecimals)).toString();
        }

        // ==================== Time Remaining ====================
        function getTimeRemaining(expiryStr) {
            if (!expiryStr || expiryStr === "Never Expire" || expiryStr === "2099-01-01") {
                return { valid: false, days: 0, hours: 0, minutes: 0, expired: false };
            }
            let expiry = null;
            if (/^\d{4}-\d{1,2}-\d{1,2}/.test(expiryStr)) {
                expiry = new Date(expiryStr);
            } else if (/^\d+$/.test(expiryStr)) {
                const num = parseInt(expiryStr);
                expiry = new Date(num > 10000000000 ? num : num * 1000);
            } else {
                expiry = new Date(expiryStr);
            }
            if (!expiry || isNaN(expiry.getTime())) {
                return { valid: false, days: 0, hours: 0, minutes: 0, expired: false };
            }

            const now = new Date();
            const diffMs = expiry.getTime() - now.getTime();

            if (diffMs <= 0) {
                return { valid: true, days: 0, hours: 0, minutes: 0, expired: true };
            }

            const totalMinutes = Math.floor(diffMs / (1000 * 60));
            const days = Math.floor(totalMinutes / (60 * 24));
            const hours = Math.floor((totalMinutes % (60 * 24)) / 60);
            const minutes = totalMinutes % 60;

            return { valid: true, days, hours, minutes, expired: false };
        }

        // ==================== Format Time Text ====================
        function formatTimeText(timeData, lang) {
            const t = I18N[lang];
            if (timeData.expired) return t.expired_text;

            const parts = [];
            if (timeData.days > 0) {
                parts.push(`${timeData.days} ${timeData.days === 1 ? t.day : t.days}`);
            }
            if (timeData.hours > 0) {
                parts.push(`${timeData.hours} ${timeData.hours === 1 ? t.hour : t.hours}`);
            }
            if (timeData.days === 0 && timeData.minutes > 0) {
                parts.push(`${timeData.minutes} ${timeData.minutes === 1 ? t.minute : t.minutes}`);
            }

            if (parts.length === 0) {
                return lang === "fa" ? "کمتر از یک دقیقه" : "less than a minute";
            }

            const joined = parts.join(` ${t.and} `);
            return `${joined} ${t.remaining_prefix}`;
        }

        // ==================== Days Percent ====================
        function calcDaysPercent(timeData) {
            if (timeData.expired) return 0;
            const totalMinutes = 30 * 24 * 60;
            const remainingMinutes = (timeData.days * 24 * 60) + (timeData.hours * 60) + timeData.minutes;
            if (remainingMinutes >= totalMinutes) return 100;
            return Math.max(0, Math.min(100, (remainingMinutes / totalMinutes) * 100));
        }

        // ==================== Locale Date ====================
        function toLocaleDate(dateStr, lang) {
            if (!dateStr || dateStr === "Never Expire" || dateStr === "2099-01-01") return "—";
            try {
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return "—";
                const locale = lang === "fa" ? "fa-IR" : "en-GB";
                return d.toLocaleDateString(locale, {
                    year: 'numeric', month: '2-digit', day: '2-digit'
                });
            } catch (e) { return "—"; }
        }

        // ==================== Apply Language ====================
        function applyLang() {
            const t = I18N[currentLang];
            document.documentElement.lang = currentLang;
            document.documentElement.dir = currentLang === "fa" ? "rtl" : "ltr";

            document.querySelectorAll("[data-i18n]").forEach(el => {
                const key = el.getAttribute("data-i18n");
                if (t[key]) el.textContent = t[key];
            });

            $("lang-flag").textContent = currentLang === "fa" ? "🇮🇷" : "🇬🇧";
            $("lang-text").textContent = currentLang === "fa" ? "FA" : "EN";
            $("footer-text").textContent = t.footer;

            render();
        }

        function toggleLang() {
            currentLang = currentLang === "fa" ? "en" : "fa";
            localStorage.setItem("vp_lang", currentLang);
            applyLang();
        }

        // ==================== Apply Theme ====================
        function applyTheme() {
            document.documentElement.classList.toggle("light", currentTheme === "light");
            $("theme-icon").textContent = currentTheme === "dark" ? "🌙" : "☀️";
        }

        function toggleTheme() {
            currentTheme = currentTheme === "dark" ? "light" : "dark";
            localStorage.setItem("vp_theme", currentTheme);
            applyTheme();
        }

        // ==================== Toast ====================
        let toastTimer = null;
        function showToast(msg) {
            const toast = $("app-toast");
            toast.textContent = msg;
            toast.classList.add("show");
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove("show"), 2500);
        }

        // ==================== Render ====================
        function render() {
            const t = I18N[currentLang];
            const usageContainer = $("usage-value-container");
            const daysContainer = $("days-value-container");

            // ========== Usage ==========
            if (isUnlimitedGB) {
                usageContainer.innerHTML = `
                    <span class="infinity">∞</span>
                    <span class="infinity-text">${t.unlimited}</span>
                `;
                setTimeout(() => {
                    $("usage-progress").style.width = "100%";
                }, 300);
            } else {
                const used = parseFloat(DATA.totalGb) || 0;
                const total = parseFloat(DATA.limitTotalGb) || 0;
                const remaining = Math.max(0, total - used);
                const percent = parseFloat(DATA.totalPercent) || 0;

                usageContainer.innerHTML = `
                    <span class="num">${formatNumber(used)}</span>
                    <span class="unit">/</span>
                    <span class="num">${formatNumber(total)}</span>
                    <span class="unit unit-accent">GB</span>
                `;

                $("used-percent").textContent = formatNumber(percent, 1);
                $("remaining-gb").textContent = formatNumber(remaining);

                setTimeout(() => {
                    $("usage-progress").style.width = Math.min(100, percent) + "%";
                }, 300);
            }

            // ========== Days ==========
            if (isUnlimitedDays) {
                daysContainer.innerHTML = `
                    <span class="infinity">∞</span>
                    <span class="infinity-text">${t.unlimited}</span>
                `;
                $("days-progress").style.width = "100%";
                $("time-remaining").textContent = t.no_expiry;
                $("expiry-date").textContent = t.no_expiry;
            } else {
                const timeData = getTimeRemaining(DATA.expiryDate);

                if (!timeData.valid) {
                    daysContainer.innerHTML = `
                        <span class="num">0</span>
                        <span class="unit unit-accent">${t.expired}</span>
                    `;
                    $("days-progress").style.width = "0%";
                    $("time-remaining").textContent = t.expired_text;
                    $("expiry-date").textContent = "—";
                } else if (timeData.expired) {
                    daysContainer.innerHTML = `
                        <span class="num">0</span>
                        <span class="unit unit-accent">${t.expired}</span>
                    `;
                    $("days-progress").style.width = "0%";
                    $("time-remaining").textContent = t.expired_text;
                    $("expiry-date").textContent = toLocaleDate(DATA.expiryDate, currentLang);
                } else {
                    daysContainer.innerHTML = `
                        <span class="num">${timeData.days}</span>
                        <span class="unit unit-accent">${t.days_unit}</span>
                    `;

                    const remainingPercent = calcDaysPercent(timeData);

                    $("time-remaining").textContent = formatTimeText(timeData, currentLang);
                    $("expiry-date").textContent = toLocaleDate(DATA.expiryDate, currentLang);

                    setTimeout(() => {
                        $("days-progress").style.width = remainingPercent + "%";
                    }, 300);
                }
            }
        }

        // ==================== App Deep Links ====================
        (function setupAppLinks() {
            const subLink = "__SYNC_NORMAL__";
            const userName = "__USER_NAME__";

            // V2rayNG
            const v2rayng = $("btn-v2rayng");
            if (v2rayng) {
                v2rayng.href = "v2rayng://install-sub?url=" + encodeURIComponent(subLink) + "&name=" + encodeURIComponent(userName);
            }

            // V2Box
            const v2box = $("btn-v2box");
            if (v2box) {
                v2box.href = "v2box://install-sub?url=" + encodeURIComponent(subLink) + "&name=" + encodeURIComponent(userName);
            }

            // Happ — کپی لینک
            const happ = $("btn-happ");
            if (happ) {
                happ.addEventListener("click", function(e) {
                    e.preventDefault();
                    const t = I18N[currentLang];
                    navigator.clipboard.writeText(subLink).then(() => {
                        showToast(t.copy_success_happ);
                    }).catch(() => {
                        showToast(t.copy_error);
                    });
                });
            }

            // NPV Tunnel — کپی لینک
            const npv = $("btn-npv");
            if (npv) {
                npv.addEventListener("click", function(e) {
                    e.preventDefault();
                    const t = I18N[currentLang];
                    navigator.clipboard.writeText(subLink).then(() => {
                        showToast(t.copy_success_npv);
                    }).catch(() => {
                        showToast(t.copy_error);
                    });
                });
            }
        })();

        // ==================== Init ====================
        (function init() {
            applyTheme();
            applyLang();
        })();
    </script>

